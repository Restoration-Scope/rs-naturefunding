# Refresh job keys. Local runs read .env.local; CI reads the repo secrets of the same name.
# EU Funding & Tenders search API (scripts/refresh/discover.ts). Optional: without it the EU half is skipped.
EU_SEARCH_API_KEY=
# Exa web search for new funders (scripts/refresh/discover-web.ts). Same Exa account as rs-allometrics: Keychain "rs-allometrics EXA_API_KEY".
EXA_API_KEY=
