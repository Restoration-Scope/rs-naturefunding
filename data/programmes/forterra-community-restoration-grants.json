    {
      "rule": "Be a 501(c)3 organization, be fiscally sponsored by a 501(c)3, or be a Tribal entity within Washington state",
      "kind": "legal"
    },
    {
      "rule": "Not a government agency, other than a Tribal government, school or school association",
      "kind": "legal"
    },
    { "rule": "Include hands-on restoration work in the project", "kind": "project" },
    {
      "rule": "Not use grant-funded work on private property inaccessible to the public",
      "kind": "project"
    },
    { "rule": "Primarily use native plants, with at least 75% native", "kind": "project" },
    {
      "rule": "Have a maintenance or continuation plan for a new restoration project on community land",
      "kind": "project"
    },
    { "rule": "Receive no more than one funding award per calendar year", "kind": "other" }
