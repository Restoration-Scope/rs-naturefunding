---
import Base from '../layouts/Base.astro'
import Row from '../components/FinderRow.astro'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { NativeSelect } from '@/components/ui/native-select'
import { Table, TableBody, TableCaption, TableHead, TableHeader, TableRow } from '@/components/ui/table'
import '../styles/finder.css'
import { listings, sortListings, stats } from '../lib/data'
import { countriesByRegion } from '../lib/geo'
import { longDate } from '../lib/format'
import { SITE_NAME, absolute } from '../lib/site'
import { accessLabels, applicantLabels, approachLabels, sizeBuckets, stateFilterLabels, type State } from '../lib/labels'

const sorted = [...listings].sort(sortListings)
const isLater = (s: State) => s === 'none' || s === 'closed'
const now = sorted.filter((l) => !isLater(l.state))
const later = sorted.filter((l) => isLater(l.state))
const count = (s: State) => listings.filter((l) => l.state === s).length

const usedApproaches = Object.entries(approachLabels).filter(([k]) => listings.some((l) => l.p.approaches.includes(k as never)))
const usedApplicants = Object.entries(applicantLabels).filter(([k]) => listings.some((l) => l.p.applicant_types?.includes(k as never)))
const states: State[] = ['open', 'rolling', 'upcoming', 'none', 'closed']
const routes = (['direct', 'intermediary', 'invitation_only'] as const).map((k) => [k, accessLabels[k]])
const num = 'font-mono tabular-nums'
const skipLink = 'absolute -top-16 left-4 z-10 rounded-md bg-surface px-3.5 py-2 text-ink focus:top-3'
// A filter group folds; its count shows how many of its filters are on.
const group = 'group/grp border-b border-rule'
const groupTitle =
  "flex min-h-10 cursor-pointer list-none items-center gap-2 py-1 text-xs font-bold tracking-[0.04em] text-ink-2 uppercase hover:text-ink after:ml-auto after:size-[0.4rem] after:border-r-[1.75px] after:border-b-[1.75px] after:border-current after:content-[''] after:[transform:translateY(-20%)_rotate(45deg)] group-open/grp:after:[transform:translateY(20%)_rotate(-135deg)] [&::-webkit-details-marker]:hidden"
const groupCount = 'px-[0.35rem] tracking-normal'
const groupHint = 'mt-[0.3rem] text-xs leading-[1.4] text-ink-2'
const opt =
  'group/opt flex min-h-[1.9rem] cursor-pointer items-center gap-2 text-sm leading-[1.3] has-disabled:cursor-default has-disabled:text-ink-2 max-xl:min-h-10 max-xl:text-md'
const optInput = 'm-0 size-4 flex-none accent-shell dark:accent-tape-open'
// .opt__text is what src/lib/finder.ts reads; the class carries no style.
const optText = 'opt__text flex-1 underline-offset-[0.18em] group-[:hover:not(:has(input:disabled))]/opt:underline'
const optN = 'font-mono text-xs text-ink-2 tabular-nums'
// The quick filters in the results summary: underlined counts that switch a filter on.
const quick =
  'inline-block min-h-7 cursor-pointer rounded-sm px-[0.35rem] py-[0.2rem] leading-[1.35rem] whitespace-nowrap underline decoration-rule-strong decoration-1 underline-offset-[0.25em] hover:decoration-current disabled:cursor-default disabled:text-ink-2 disabled:no-underline aria-pressed:no-underline @max-[40rem]/tbl:px-[0.3rem]'
const quickOn = 'text-ink aria-pressed:bg-tape-open aria-pressed:text-tape-ink'
const description =
  'A free directory of funding for nature restoration and conservation. Every deadline, amount and eligibility rule links to the funder’s own page, with the words it rests on and the date we read it.'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absolute('/'),
    description,
    publisher: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Grants and funding for nature restoration and conservation',
    description:
      'Funding programmes and calls for nature restoration and conservation. Each fact carries the funder page it was read from, a verbatim quote and the date it was checked.',
    url: absolute('/'),
    license: 'https://creativecommons.org/licenses/by/4.0/',
    isAccessibleForFree: true,
    creator: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
    dateModified: stats.lastChecked ?? undefined,
    keywords: ['restoration grants', 'conservation funding', 'reforestation grants', 'mangrove funding'],
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: absolute('/data.json') },
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: absolute('/data.csv') },
    ],
  },
]
---

<Base
  title="naturefunding.org: funding for nature restoration, checked against each funder’s page"
  description={description}
  path="/"
  nav="finder"
  jsonLd={jsonLd}
>
  <div slot="band" class="wrap pt-2 pb-[1.1rem] max-md:pt-0 max-md:pb-3">
    <h1 class="max-w-[40ch] text-[clamp(1.1875rem,0.95rem+1vw,1.75rem)] leading-[1.15] font-extrabold tracking-[-0.015em]">Funding for nature restoration and conservation, checked against each funder’s own page.</h1>
    <p class="mt-[0.4rem] max-w-[75ch] text-md text-shell-ink-2 max-md:text-sm max-md:leading-[1.4]">
      <span class="max-md:hidden">Every deadline, amount and eligibility rule links to the funder’s own page, with the words it rests on and the date we read it.</span>{' '}
      Free, with no paid listings or paid ranking. Built openly by Restoration Scope.
    </p>
    <p class="mt-[0.6rem] flex flex-wrap gap-x-6 gap-y-1 text-sm text-shell-ink-2 max-md:hidden [&_strong]:text-shell-ink">
      <span><strong class={num}>{stats.open}</strong> open now, <strong class={num}>{stats.rolling}</strong> open any time</span>
      <span><strong class={num}>{stats.programmes}</strong> programmes listed</span>
      {stats.lastChecked && <span>Last checked {longDate(stats.lastChecked)}</span>}
    </p>
  </div>

  <div class="wrap mt-3 grid grid-cols-[minmax(0,1fr)] gap-3 xl:mt-5 xl:grid-cols-[14rem_minmax(0,1fr)] xl:gap-7">
    <a class={skipLink} href="#results">Skip to results</a>
    {/* Wide screens: the filters ride in a sticky column. Phones and tablets: they open in a sheet. */}
    <form
      class="xl:sticky xl:top-0 xl:max-h-dvh xl:self-start xl:overflow-y-auto xl:pt-1 xl:pr-1 xl:pb-6 xl:[scrollbar-width:thin]"
      role="search"
      aria-label="Search and filter funding"
      data-form
    >
      <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-2 xl:grid-cols-[minmax(0,1fr)] xl:pt-2">
        <Label htmlFor="q" className="col-span-full mb-[0.3rem] max-xl:sr-only">Search</Label>
        <Input id="q" name="q" type="search" placeholder="Search funder or place" autoComplete="off" />
        <button
          type="button"
          class="inline-flex min-h-10 cursor-pointer items-center gap-[0.4rem] rounded-md border-[1.5px] border-input bg-surface px-[0.8rem] text-md font-bold text-ink xl:hidden!"
          data-sheet-open
          aria-controls="filters"
          aria-expanded="false"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M4.5 8h7M7 12h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          Filters <Badge variant="count" data-filter-count="" hidden />
        </button>
      </div>

      <div class="fixed inset-0 z-29 bg-backdrop xl:hidden!" data-backdrop hidden></div>
      <div
        class="max-xl:fixed max-xl:inset-x-0 max-xl:bottom-0 max-xl:z-30 max-xl:flex max-xl:max-h-[min(88dvh,44rem)] max-xl:flex-col max-xl:rounded-t-xl max-xl:bg-ground max-xl:shadow-[0_-8px_32px_rgb(0_0_0/0.3)] max-xl:not-data-open:hidden xl:mt-3"
        id="filters"
        data-sheet
        aria-label="Filters"
      >
        <div class="flex items-center justify-between border-b border-rule pt-[0.6rem] pr-2 pb-[0.4rem] pl-4 xl:hidden!">
          <h2 class="text-lg font-bold">Filters</h2>
          <button type="button" class="grid size-11 cursor-pointer place-items-center text-ink" data-sheet-close aria-label="Close filters">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </button>
        </div>

        <div class="max-xl:flex-1 max-xl:overflow-y-auto max-xl:overscroll-contain max-xl:px-4">
          {/* Sorting sits in the sheet on phones and tablets; wide screens sort from the table header. */}
          <div class="border-b border-rule py-3 xl:hidden">
            <Label htmlFor="sort" className="mb-[0.3rem]">Sort by</Label>
            <NativeSelect id="sort" data-sort-select="">
              <option value="deadline">Soonest deadline</option>
              <option value="amount">Largest amount</option>
              <option value="checked">Recently checked</option>
            </NativeSelect>
          </div>
          <details class={group} open data-group="status">
            <summary class={groupTitle}><span>Status</span><Badge variant="count" className={groupCount} data-gcount="status" hidden /></summary>
            <div class="pb-[0.6rem]">
              {
                states.map((s) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="status" value={s} />
                    <span class={optText}>{stateFilterLabels[s]}</span>
                    <span class={optN} data-n={`status:${s}`}>{count(s)}</span>
                  </label>
                ))
              }
            </div>
          </details>

          <details class={group} open data-group="within">
            <summary class={groupTitle}><span>Deadline</span><Badge variant="count" className={groupCount} data-gcount="within" hidden /></summary>
            <div class="pb-[0.6rem]">
              <label class={opt}><input class={optInput} type="radio" name="within" value="" checked /><span class={optText}>Any time</span></label>
              <label class={opt}><input class={optInput} type="radio" name="within" value="7" /><span class={optText}>Closes within 7 days</span></label>
              <label class={opt}><input class={optInput} type="radio" name="within" value="30" /><span class={optText}>Within 30 days</span></label>
              <label class={opt}><input class={optInput} type="radio" name="within" value="90" /><span class={optText}>Within 90 days</span></label>
            </div>
          </details>

          <details class={group} open data-group="where">
            <summary class={groupTitle}><span>Where the project is</span><Badge variant="count" className={groupCount} data-gcount="where" hidden /></summary>
            <div class="pb-[0.6rem]">
              <label class="sr-only" for="where">Where the project is</label>
              <NativeSelect id="where" name="where">
                <option value="">Anywhere</option>
                <optgroup label="Regions">
                  {countriesByRegion.map((r) => <option value={`r:${r.region}`}>{r.label}</option>)}
                </optgroup>
                {
                  countriesByRegion.map((r) => (
                    <optgroup label={r.label}>
                      {r.countries.map((c) => (
                        <option value={c.code} data-region={r.region}>{c.name}</option>
                      ))}
                    </optgroup>
                  ))
                }
              </NativeSelect>
              <p class={groupHint}>Programmes that may fund there, worldwide ones included. Each call sets its own countries.</p>
            </div>
          </details>

          <details class={group} open data-group="access">
            <summary class={groupTitle}><span>How to apply</span><Badge variant="count" className={groupCount} data-gcount="access" hidden /></summary>
            <div class="pb-[0.6rem]">
              {
                routes.map(([k, label]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="access" value={k} />
                    <span class={optText}>{label}</span>
                    <span class={optN} data-n={`access:${k}`} />
                  </label>
                ))
              }
            </div>
          </details>

          <details class={group} data-group="size">
            <summary class={groupTitle}><span>Grant size</span><Badge variant="count" className={groupCount} data-gcount="size" hidden /></summary>
            <div class="pb-[0.6rem]">
              {
                Object.entries(sizeBuckets).map(([k, b]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="size" value={k} />
                    <span class={optText}>{b.label}</span>
                    <span class={optN} data-n={`size:${k}`} />
                  </label>
                ))
              }
              <p class={groupHint}>Converted roughly to US dollars, only for this filter.</p>
            </div>
          </details>

          <details class={group} data-group="applicant">
            <summary class={groupTitle}><span>Who can apply</span><Badge variant="count" className={groupCount} data-gcount="applicant" hidden /></summary>
            <div class="pb-[0.6rem]">
              {
                usedApplicants.map(([k, label]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="applicant" value={k} />
                    <span class={optText}>{label}</span>
                    <span class={optN} data-n={`applicant:${k}`} />
                  </label>
                ))
              }
            </div>
          </details>

          <details class={group} data-group="approach">
            <summary class={groupTitle}><span>Approach</span><Badge variant="count" className={groupCount} data-gcount="approach" hidden /></summary>
            <div class="pb-[0.6rem]">
              {
                usedApproaches.map(([k, label]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="approach" value={k} />
                    <span class={optText}>{label}</span>
                    <span class={optN} data-n={`approach:${k}`} />
                  </label>
                ))
              }
            </div>
          </details>
        </div>

        <div class="flex items-center gap-3 border-t border-rule bg-surface px-4 pt-[0.65rem] pb-[calc(0.65rem+env(safe-area-inset-bottom))] xl:hidden!">
          <button type="button" class="min-h-11 cursor-pointer px-2 text-link underline underline-offset-[0.18em]" data-reset>Clear all</button>
          <Button className="flex-1" data-sheet-done="">Show {sorted.length} results</Button>
        </div>
      </div>
    </form>

    {/* The results are a container: the summary, the bar and the table reflow by their own width. */}
    <section class="results @container/tbl min-w-0" id="results" tabindex="-1" aria-labelledby="summary">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-[0.35rem] pb-[0.6rem] @max-[40rem]/tbl:gap-y-[0.15rem] @max-[40rem]/tbl:pb-[0.4rem]">
        {/* The summary is the quick filter. */}
        <h2
          id="summary"
          class="-ml-[0.35rem] flex flex-wrap items-center gap-x-[0.4rem] gap-y-[0.3rem] text-base leading-[1.3] font-normal [text-wrap:initial] @max-[40rem]/tbl:gap-x-[0.1rem] @max-[40rem]/tbl:gap-y-0 @max-[40rem]/tbl:text-md"
          data-summary
        >
          <button type="button" class:list={[quick, quickOn]} data-quick="status:open" aria-pressed="false"><b class={num} data-qn="open">{count('open')}</b> <span data-ql="open">open now</span></button>
          <button type="button" class:list={[quick, 'text-ink aria-pressed:bg-aging aria-pressed:text-tape-ink [&_b]:text-aging-text aria-pressed:[&_b]:text-inherit']} data-quick="within:7" aria-pressed="false"><b class={num} data-qn="soon">0</b> closing within 7 days</button>
          <button type="button" class:list={[quick, quickOn]} data-quick="status:rolling" aria-pressed="false"><b class={num} data-qn="rolling">{count('rolling')}</b> rolling</button>
          <button type="button" class:list={[quick, quickOn]} data-quick="status:upcoming" aria-pressed="false"><b class={num} data-qn="upcoming">{count('upcoming')}</b> upcoming</button>
          <button
            type="button"
            class:list={[quick, 'group/later text-ink-2 aria-pressed:bg-sunk aria-pressed:text-ink aria-pressed:shadow-[inset_0_0_0_1px_var(--rule-strong)]']}
            data-later-toggle
            aria-pressed="false"
            aria-controls="later-head later-rows"
          >
            <span
              class="mr-[0.4rem] ml-[0.1rem] inline-block size-[0.4rem] border-r-[1.75px] border-b-[1.75px] border-current [transform:translateY(-0.12em)_rotate(45deg)] group-aria-pressed/later:[transform:translateY(0.12em)_rotate(-135deg)]"
              aria-hidden="true"
            ></span><span data-later-verb>Show</span> <b class={num} data-qn="later">{later.length}</b> not open now
          </button>
        </h2>
        <p class="ml-auto flex flex-wrap items-baseline gap-x-3 text-sm text-ink-2 @max-[40rem]/tbl:ml-0">
          <span class="whitespace-nowrap text-ink" data-shown>{now.length} of {sorted.length} shown</span>
          <span data-sort-line>Open calls first, soonest deadline first</span>
        </p>
      </div>
      <p class="sr-only" aria-live="polite" data-live></p>
      <div class="flex flex-wrap gap-[0.35rem] pb-[0.6rem]" data-chips hidden></div>

      <Table className="tbl">
        <TableCaption className="sr-only">Funding programmes. Sortable by deadline, amount and date checked.</TableCaption>
        <TableHeader>
          <TableRow>
            <TableHead scope="col" className="h-prog">Programme <span class="h-sub">and funder</span></TableHead>
            <TableHead scope="col" className="h-dl" aria-sort="ascending" data-col="deadline">
              <button type="button" data-sort="deadline">Status and deadline <span class="arrow" aria-hidden="true"></span></button>
            </TableHead>
            <TableHead scope="col" className="h-amount" data-col="amount">
              <button type="button" data-sort="amount">Amount <span class="arrow" aria-hidden="true"></span></button>
              <button type="button" class="h-alt" data-sort="checked" data-alt-for="checked">Checked <span class="arrow" aria-hidden="true"></span></button>
            </TableHead>
            <TableHead scope="col" className="h-rc" data-col="checked">
              <span class="h-route">Route ·</span>
              <button type="button" data-sort="checked">Checked <span class="arrow" aria-hidden="true"></span></button>
            </TableHead>
          </TableRow>
        </TableHeader>
        <TableBody data-list="">
          {now.map((l) => <Row listing={l} />)}
        </TableBody>
        <TableBody className="later-head" id="later-head" data-later-head="" hidden>
          <TableRow>
            <TableHead colSpan={4} scope="colgroup">
              <span class="later-head__title">Not open now</span>
              <span class="later-head__hint">No call found, or closed. Listed so you can plan ahead.</span>
              <button type="button" class="linkish" data-later-hide>Hide</button>
            </TableHead>
          </TableRow>
        </TableBody>
        <TableBody className="later-rows" id="later-rows" data-list-later="" hidden>
          {later.map((l) => <Row listing={l} />)}
        </TableBody>
      </Table>

      <button
        type="button"
        class="mt-5 flex min-h-12 w-full cursor-pointer flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-md border-[1.5px] border-input bg-surface px-[0.9rem] py-[0.6rem] text-left text-ink hover:border-ink"
        data-later-toggle
        data-endfold
        aria-controls="later-head later-rows"
        aria-pressed="false"
      >
        <span class="font-extrabold">Not open now</span>
        <span class="font-bold text-link underline underline-offset-[0.18em]">Show all <b class={num} data-qn-end>{later.length}</b></span>
      </button>

      <div class="px-2 py-8" data-empty hidden>
        <h3 class="text-xl font-bold" data-empty-head>Nothing matches.</h3>
        <p class="mt-[0.4rem] text-ink-2" data-empty-text>Try another search, remove a filter, or <button type="button" class="linkish" data-reset>clear all</button>.</p>
      </div>
      <noscript>
        <p class="pt-4 text-ink-2">Filters and sorting need JavaScript. Calls open now are listed above, soonest deadline first.</p>
      </noscript>
    </section>
  </div>
</Base>

<script>
  import { initTableFinder } from '../lib/finder'
  initTableFinder()
</script>
