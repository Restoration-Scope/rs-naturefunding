---
import Base from '../layouts/Base.astro'
import Row from '../components/FinderRow.astro'
import { listings, sortListings, stats } from '../lib/data'
import { countriesByRegion } from '../lib/geo'
import { longDate } from '../lib/format'
import { SITE_NAME, absolute } from '../lib/site'
import { accessLabels, applicantLabels, approachLabels, sizeBuckets, stateFilterLabels, type State } from '../lib/labels'

const sorted = [...listings].sort(sortListings)
const isLater = (s: State) => s === 'none' || s === 'closed'
const now = sorted.filter((l) => !isLater(l.state))
const later = sorted.filter((l) => isLater(l.state))
const count = (s: State) => listings.filter((l) => l.state === s).length

const usedApproaches = Object.entries(approachLabels).filter(([k]) => listings.some((l) => l.p.approaches.includes(k as never)))
const usedApplicants = Object.entries(applicantLabels).filter(([k]) => listings.some((l) => l.p.applicant_types?.includes(k as never)))
const states: State[] = ['open', 'rolling', 'upcoming', 'none', 'closed']
const routes = (['direct', 'intermediary', 'invitation_only'] as const).map((k) => [k, accessLabels[k]])
const description =
  'A free directory of funding for nature restoration and conservation. Every deadline, amount and eligibility rule links to the funder’s own page, with the words it rests on and the date we read it.'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absolute('/'),
    description,
    publisher: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Grants and funding for nature restoration and conservation',
    description:
      'Funding programmes and calls for nature restoration and conservation. Each fact carries the funder page it was read from, a verbatim quote and the date it was checked.',
    url: absolute('/'),
    license: 'https://creativecommons.org/licenses/by/4.0/',
    isAccessibleForFree: true,
    creator: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
    dateModified: stats.lastChecked ?? undefined,
    keywords: ['restoration grants', 'conservation funding', 'reforestation grants', 'mangrove funding'],
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: absolute('/data.json') },
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: absolute('/data.csv') },
    ],
  },
]
---

<Base
  title="naturefunding.org: funding for nature restoration, checked against each funder’s page"
  description={description}
  path="/"
  nav="finder"
  jsonLd={jsonLd}
>
  <div slot="band" class="wrap band">
    <h1 class="band__title">Funding for nature restoration and conservation, checked against each funder’s own page.</h1>
    <p class="band__lede">
      <span class="band__more">Every deadline, amount and eligibility rule links to the funder’s own page, with the words it rests on and the date we read it.</span>{' '}
      Free, with no paid listings or paid ranking. Built openly by Restoration Scope.
    </p>
    <p class="band__stats">
      <span><strong class="mono">{stats.open}</strong> open now, <strong class="mono">{stats.rolling}</strong> open any time</span>
      <span><strong class="mono">{stats.programmes}</strong> programmes listed</span>
      {stats.lastChecked && <span>Last checked {longDate(stats.lastChecked)}</span>}
    </p>
  </div>

  <div class="wrap finder">
    <a class="skip" href="#results">Skip to results</a>
    <form class="side" role="search" aria-label="Search and filter funding" data-form>
      <div class="side__search">
        <label class="side__label" for="q">Search</label>
        <input id="q" name="q" type="search" placeholder="Search funder or place" autocomplete="off" />
        <button type="button" class="sheet-open" data-sheet-open aria-controls="filters" aria-expanded="false">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M4.5 8h7M7 12h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          Filters <span class="badge mono" data-filter-count hidden></span>
        </button>
      </div>

      <div class="backdrop" data-backdrop hidden></div>
      <div class="sheet" id="filters" data-sheet aria-label="Filters">
        <div class="sheet__head">
          <h2 class="sheet__title">Filters</h2>
          <button type="button" class="sheet__close" data-sheet-close aria-label="Close filters">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </button>
        </div>

        <div class="sheet__body">
          <div class="grp grp--sort">
            <label class="grp__label" for="sort">Sort by</label>
            <select id="sort" data-sort-select>
              <option value="deadline">Soonest deadline</option>
              <option value="amount">Largest amount</option>
              <option value="checked">Recently checked</option>
            </select>
          </div>
          <details class="grp" open data-group="status">
            <summary><span>Status</span><span class="grp__n mono" data-gcount="status" hidden></span></summary>
            <div class="grp__body">
              {
                states.map((s) => (
                  <label class="opt">
                    <input type="checkbox" name="status" value={s} />
                    <span class="opt__text">{stateFilterLabels[s]}</span>
                    <span class="opt__n mono" data-n={`status:${s}`}>{count(s)}</span>
                  </label>
                ))
              }
            </div>
          </details>

          <details class="grp" open data-group="within">
            <summary><span>Deadline</span><span class="grp__n mono" data-gcount="within" hidden></span></summary>
            <div class="grp__body">
              <label class="opt"><input type="radio" name="within" value="" checked /><span class="opt__text">Any time</span></label>
              <label class="opt"><input type="radio" name="within" value="7" /><span class="opt__text">Closes within 7 days</span></label>
              <label class="opt"><input type="radio" name="within" value="30" /><span class="opt__text">Within 30 days</span></label>
              <label class="opt"><input type="radio" name="within" value="90" /><span class="opt__text">Within 90 days</span></label>
            </div>
          </details>

          <details class="grp" open data-group="where">
            <summary><span>Where the project is</span><span class="grp__n mono" data-gcount="where" hidden></span></summary>
            <div class="grp__body">
              <label class="visually-hidden" for="where">Where the project is</label>
              <select id="where" name="where">
                <option value="">Anywhere</option>
                <optgroup label="Regions">
                  {countriesByRegion.map((r) => <option value={`r:${r.region}`}>{r.label}</option>)}
                </optgroup>
                {
                  countriesByRegion.map((r) => (
                    <optgroup label={r.label}>
                      {r.countries.map((c) => (
                        <option value={c.code} data-region={r.region}>{c.name}</option>
                      ))}
                    </optgroup>
                  ))
                }
              </select>
              <p class="grp__hint">Programmes that may fund there, worldwide ones included. Each call sets its own countries.</p>
            </div>
          </details>

          <details class="grp" open data-group="access">
            <summary><span>How to apply</span><span class="grp__n mono" data-gcount="access" hidden></span></summary>
            <div class="grp__body">
              {
                routes.map(([k, label]) => (
                  <label class="opt">
                    <input type="checkbox" name="access" value={k} />
                    <span class="opt__text">{label}</span>
                    <span class="opt__n mono" data-n={`access:${k}`} />
                  </label>
                ))
              }
            </div>
          </details>

          <details class="grp" data-group="size">
            <summary><span>Grant size</span><span class="grp__n mono" data-gcount="size" hidden></span></summary>
            <div class="grp__body">
              {
                Object.entries(sizeBuckets).map(([k, b]) => (
                  <label class="opt">
                    <input type="checkbox" name="size" value={k} />
                    <span class="opt__text">{b.label}</span>
                    <span class="opt__n mono" data-n={`size:${k}`} />
                  </label>
                ))
              }
              <p class="grp__hint">Converted roughly to US dollars, only for this filter.</p>
            </div>
          </details>

          <details class="grp" data-group="applicant">
            <summary><span>Who can apply</span><span class="grp__n mono" data-gcount="applicant" hidden></span></summary>
            <div class="grp__body">
              {
                usedApplicants.map(([k, label]) => (
                  <label class="opt">
                    <input type="checkbox" name="applicant" value={k} />
                    <span class="opt__text">{label}</span>
                    <span class="opt__n mono" data-n={`applicant:${k}`} />
                  </label>
                ))
              }
            </div>
          </details>

          <details class="grp" data-group="approach">
            <summary><span>Approach</span><span class="grp__n mono" data-gcount="approach" hidden></span></summary>
            <div class="grp__body">
              {
                usedApproaches.map(([k, label]) => (
                  <label class="opt">
                    <input type="checkbox" name="approach" value={k} />
                    <span class="opt__text">{label}</span>
                    <span class="opt__n mono" data-n={`approach:${k}`} />
                  </label>
                ))
              }
            </div>
          </details>
        </div>

        <div class="sheet__foot">
          <button type="button" class="sheet__clear" data-reset>Clear all</button>
          <button type="button" class="button sheet__done" data-sheet-done>Show {sorted.length} results</button>
        </div>
      </div>
    </form>

    <section class="results" id="results" tabindex="-1" aria-labelledby="summary">
      <div class="bar">
        <h2 id="summary" class="summary" data-summary>
          <button type="button" class="q" data-quick="status:open" aria-pressed="false"><b class="mono" data-qn="open">{count('open')}</b> <span data-ql="open">open now</span></button>
          <button type="button" class="q q--soon" data-quick="within:7" aria-pressed="false"><b class="mono" data-qn="soon">0</b> closing within 7 days</button>
          <button type="button" class="q" data-quick="status:rolling" aria-pressed="false"><b class="mono" data-qn="rolling">{count('rolling')}</b> rolling</button>
          <button type="button" class="q" data-quick="status:upcoming" aria-pressed="false"><b class="mono" data-qn="upcoming">{count('upcoming')}</b> upcoming</button>
          <button type="button" class="q q--later" data-later-toggle aria-pressed="false" aria-controls="later-head later-rows">
            <span class="q--later__icon" aria-hidden="true"></span><span data-later-verb>Show</span> <b class="mono" data-qn="later">{later.length}</b> not open now
          </button>
        </h2>
        <p class="bar__side">
          <span class="bar__shown" data-shown>{now.length} of {sorted.length} shown</span>
          <span class="bar__sort" data-sort-line>Open calls first, soonest deadline first</span>
        </p>
      </div>
      <p class="visually-hidden" aria-live="polite" data-live></p>
      <div class="chips" data-chips hidden></div>

      <table class="tbl">
        <caption class="visually-hidden">Funding programmes. Sortable by deadline, amount and date checked.</caption>
        <thead>
          <tr>
            <th scope="col" class="h-prog">Programme <span class="h-sub">and funder</span></th>
            <th scope="col" class="h-dl" aria-sort="ascending" data-col="deadline">
              <button type="button" data-sort="deadline">Status and deadline <span class="arrow" aria-hidden="true"></span></button>
            </th>
            <th scope="col" class="h-amount" data-col="amount">
              <button type="button" data-sort="amount">Amount <span class="arrow" aria-hidden="true"></span></button>
              <button type="button" class="h-alt" data-sort="checked" data-alt-for="checked">Checked <span class="arrow" aria-hidden="true"></span></button>
            </th>
            <th scope="col" class="h-rc" data-col="checked">
              <span class="h-route">Route ·</span>
              <button type="button" data-sort="checked">Checked <span class="arrow" aria-hidden="true"></span></button>
            </th>
          </tr>
        </thead>
        <tbody data-list>
          {now.map((l) => <Row listing={l} />)}
        </tbody>
        <tbody class="later-head" id="later-head" data-later-head hidden>
          <tr>
            <th colspan="4" scope="colgroup">
              <span class="later-head__title">Not open now</span>
              <span class="later-head__hint">No call found, or closed. Listed so you can plan ahead.</span>
              <button type="button" class="linkish" data-later-hide>Hide</button>
            </th>
          </tr>
        </tbody>
        <tbody class="later-rows" id="later-rows" data-list-later hidden>
          {later.map((l) => <Row listing={l} />)}
        </tbody>
      </table>

      <button type="button" class="endfold" data-later-toggle data-endfold aria-controls="later-head later-rows" aria-pressed="false">
        <span class="endfold__title">Not open now</span>
        <span class="endfold__action">Show all <b class="mono" data-qn-end>{later.length}</b></span>
      </button>

      <div class="empty" data-empty hidden>
        <h3 data-empty-head>Nothing matches.</h3>
        <p data-empty-text>Try another search, remove a filter, or <button type="button" class="linkish" data-reset>clear all</button>.</p>
      </div>
      <noscript>
        <p class="noscript">Filters and sorting need JavaScript. Calls open now are listed above, soonest deadline first.</p>
      </noscript>
    </section>
  </div>
</Base>

<script>
  import { initTableFinder } from '../lib/finder'
  initTableFinder()
</script>


<style>
  .band {
    padding-block: 0.5rem 1.1rem;
  }
  .band__title {
    max-width: 40ch;
    font-size: clamp(1.1875rem, 0.95rem + 1vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .band__lede {
    max-width: 75ch;
    margin-top: 0.4rem;
    color: var(--shell-ink-2);
    font-size: 0.9375rem;
  }
  .band__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--shell-ink-2);
  }
  .band__stats strong {
    color: var(--shell-ink);
  }
  @media (max-width: 47.99rem) {
    .band {
      padding-block: 0 0.75rem;
    }
    .band__more,
    .band__stats {
      display: none;
    }
    .band__lede {
      font-size: 0.875rem;
      line-height: 1.4;
    }
  }

  .finder {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  @media (min-width: 68rem) {
    .finder {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 1.75rem;
      margin-top: 1.25rem;
    }
  }

  /* ---------- Side: search and filters ---------- */
  .side__label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .side__search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }
  .side__search .side__label {
    grid-column: 1 / -1;
  }
  input[type='search'],
  select {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.4rem 0.65rem;
    border: 1.5px solid var(--control-edge);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  input[type='search']::placeholder {
    color: var(--ink-2);
    opacity: 1;
  }
  input[type='search']:focus-visible,
  select:focus-visible {
    border-color: var(--focus);
    outline-offset: 0;
  }
  .sheet-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.8rem;
    border: 1.5px solid var(--control-edge);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .badge {
    padding: 0 0.4rem;
    border-radius: 2px;
    background: var(--tape-open);
    color: var(--tape-ink);
    font-size: 0.8125rem;
  }

  @media (max-width: 67.99rem) {
    .side__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    /* Phones and tablets: filters open in a sheet from the bottom, over the results. */
    .sheet {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 30;
      display: none;
      flex-direction: column;
      max-height: min(88dvh, 44rem);
      background: var(--ground);
      border-radius: 10px 10px 0 0;
      box-shadow: 0 -8px 32px oklch(0 0 0 / 0.3);
    }
    .sheet[data-open] {
      display: flex;
    }
    .backdrop {
      position: fixed;
      inset: 0;
      z-index: 29;
      background: oklch(0.15 0.02 190 / 0.55);
    }
    .sheet__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 0.5rem 0.4rem 1rem;
      border-bottom: 1px solid var(--rule);
    }
    .sheet__title {
      font-size: 1.0625rem;
    }
    .sheet__close {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      background: none;
      color: var(--ink);
      cursor: pointer;
    }
    .sheet__body {
      flex: 1;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0 1rem;
    }
    .sheet__foot {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--rule);
      background: var(--surface);
    }
    .sheet__done {
      flex: 1;
    }
    .sheet__clear {
      min-height: 2.75rem;
      padding: 0 0.5rem;
      border: 0;
      background: none;
      color: var(--link);
      font: inherit;
      text-decoration: underline;
      text-underline-offset: 0.18em;
      cursor: pointer;
    }
  }
  @media (min-width: 68rem) {
    .side {
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100dvh;
      overflow-y: auto;
      padding: 0.25rem 0.25rem 1.5rem 0;
      scrollbar-width: thin;
    }
    .side__search {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 0.5rem;
    }
    .sheet-open,
    .sheet__head,
    .sheet__foot,
    .backdrop {
      display: none !important;
    }
    .sheet {
      margin-top: 0.75rem;
    }
  }

  .grp {
    border-bottom: 1px solid var(--rule);
  }
  .grp summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.25rem 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }
  .grp summary::-webkit-details-marker {
    display: none;
  }
  .grp summary::after {
    content: '';
    margin-left: auto;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.75px solid currentColor;
    border-bottom: 1.75px solid currentColor;
    transform: translateY(-20%) rotate(45deg);
  }
  .grp[open] summary::after {
    transform: translateY(20%) rotate(-135deg);
  }
  .grp summary:hover {
    color: var(--ink);
  }
  .grp__n {
    padding: 0 0.35rem;
    border-radius: 2px;
    background: var(--tape-open);
    color: var(--tape-ink);
    letter-spacing: 0;
  }
  .grp__body {
    padding-bottom: 0.6rem;
  }
  .grp__hint {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .opt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.9rem;
    font-size: 0.875rem;
    line-height: 1.3;
    cursor: pointer;
  }
  @media (max-width: 67.99rem) {
    .opt {
      min-height: 2.5rem;
      font-size: 0.9375rem;
    }
  }
  .opt input {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--shell);
  }
  @media (prefers-color-scheme: dark) {
    .opt input {
      accent-color: var(--tape-open);
    }
  }
  .opt__text {
    flex: 1;
  }
  .opt__n {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .opt:has(input:disabled) {
    color: var(--ink-2);
    cursor: default;
  }
  .opt:hover:not(:has(input:disabled)) .opt__text {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* ---------- Results bar: the summary is the quick filter ---------- */
  .results {
    container: tbl / inline-size;
    min-width: 0;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding-bottom: 0.6rem;
  }
  .summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.4rem;
    margin-left: -0.35rem;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3;
    text-wrap: initial;
  }
  .q {
    display: inline-block;
    min-height: 1.75rem;
    padding: 0.2rem 0.35rem;
    border: 0;
    border-radius: 3px;
    background: none;
    color: var(--ink);
    font: inherit;
    line-height: 1.35rem;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .q b {
    font-weight: 700;
  }
  .q:hover {
    text-decoration-color: currentColor;
  }
  .q[aria-pressed='true'] {
    background: var(--tape-open);
    color: var(--tape-ink);
    text-decoration: none;
  }
  .q--soon b {
    color: var(--aging-text);
  }
  .q--soon[aria-pressed='true'] {
    background: var(--aging);
  }
  .q--soon[aria-pressed='true'] b {
    color: inherit;
  }
  .q:disabled {
    color: var(--ink-2);
    text-decoration: none;
    cursor: default;
  }
  .q--later {
    color: var(--ink-2);
  }
  .q--later[aria-pressed='true'] {
    background: var(--sunk);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }
  .q--later__icon {
    display: inline-block;
