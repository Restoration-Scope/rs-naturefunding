---
import Base from '../layouts/Base.astro'
import Row from '../components/FinderRow.astro'
import { ArrowDown, ArrowUp, Bird, Building2, ChevronDown, ChevronsUpDown, Droplets, LayoutGrid, Microscope, Search, SlidersHorizontal, Trees, Users, Waves, Wheat, X } from 'lucide-react'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { NativeSelect } from '@/components/ui/native-select'
import { Table, TableBody, TableCaption, TableHead, TableHeader, TableRow } from '@/components/ui/table'
import '../styles/finder.css'
import { listings, sortListings, stats } from '../lib/data'
import { countriesByRegion } from '../lib/geo'
import { longDate } from '../lib/format'
import { SITE_NAME, absolute } from '../lib/site'
import { accessLabels, applicantLabels, approachLabels, projectTypes, sizeBuckets, stateFilterLabels, type State } from '../lib/labels'

const sorted = [...listings].sort(sortListings)
const isLater = (s: State) => s === 'none' || s === 'closed'
const now = sorted.filter((l) => !isLater(l.state))
const later = sorted.filter((l) => isLater(l.state))
const count = (s: State) => listings.filter((l) => l.state === s).length

const usedApproaches = Object.entries(approachLabels).filter(([k]) => listings.some((l) => l.p.approaches.includes(k as never)))
const usedApplicants = Object.entries(applicantLabels).filter(([k]) => listings.some((l) => l.p.applicant_types?.includes(k as never)))
const states: State[] = ['open', 'rolling', 'upcoming', 'none', 'closed']
const routes = (['direct', 'intermediary', 'invitation_only'] as const).map((k) => [k, accessLabels[k]])
const num = 'tabular-nums'
const skipLink = 'absolute -top-16 left-4 z-10 rounded-md bg-surface px-3.5 py-2 text-ink focus:top-3'
// Every filter group stays open: a heading, then all its options. The badge counts its filters that are on.
// A legend sits on its fieldset's top edge, so the heading carries the group's top space.
const group = 'border-b border-rule pb-3.5 last:border-b-0'
const groupTitle = 'mb-2 flex items-center gap-2 px-0 pt-3.5 pb-0 text-sm font-semibold text-foreground'
const groupHint = 'mt-[0.3rem] text-xs leading-[1.4] text-ink-2'
const opt =
  'group/opt flex min-h-[1.9rem] cursor-pointer items-center gap-2 text-sm leading-[1.3] has-disabled:cursor-default has-disabled:text-ink-2 max-xl:min-h-10 max-xl:text-md'
const optInput = 'm-0 size-4 flex-none accent-primary'
// .opt__text is what src/lib/finder.ts reads; the class carries no style.
// group-hover only applies where the device can hover, so a tap leaves no underline behind.
const optText = 'opt__text flex-1 underline-offset-[0.18em] group-hover/opt:underline group-has-disabled/opt:no-underline'
const optN = 'text-xs text-muted-foreground tabular-nums'
// The quick filters in the results summary: a row of shadcn toggles (outline Button, rounded-full), each
// with its count in a Badge. Pressed, they take the primary fill.
const quick =
  'group/q inline-flex h-8 shrink-0 pointer-coarse:h-10 cursor-pointer snap-start items-center gap-1.5 rounded-full border border-border bg-card pr-1.5 pl-3 text-sm font-medium whitespace-nowrap text-foreground shadow-xs hover:bg-muted disabled:cursor-default disabled:opacity-50 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground'
const quickNBase =
  'inline-flex min-w-5 justify-center rounded-full px-1.5 text-xs leading-[1.35] font-medium tabular-nums group-aria-pressed/q:bg-brand-dark group-aria-pressed/q:text-primary-foreground'
const quickN = `${quickNBase} bg-secondary text-secondary-foreground`
// The header's project types, each a link that sets the Approach filter (data-cat: its approaches, sorted).
const typeIcons = { forests: Trees, coasts: Waves, wetlands: Droplets, grasslands: Wheat, wildlife: Bird, communities: Users, cities: Building2, research: Microscope }
const types = [
  { key: 'all', label: 'All', Icon: LayoutGrid, approaches: [] as string[] },
  // Only approaches some listing has, as those are the finder's checkboxes; a type with none is left out.
  ...projectTypes
    .map((t) => ({ ...t, approaches: t.approaches.filter((a) => usedApproaches.some(([k]) => k === a)), Icon: typeIcons[t.key as keyof typeof typeIcons] }))
    .filter((t) => t.approaches.length),
].map((t) => ({ ...t, cat: [...t.approaches].sort().join(' '), href: t.approaches.length ? `/?approach=${t.approaches.join(',')}` : '/' }))
// The search bar's segments: a bold label over a borderless select. The select fills the segment, so the
// whole segment opens it; a value still at its default reads muted. With JavaScript, src/lib/picker.ts turns
// Where into a combobox with flags and When and Who into Base UI–style selects, with these same classes.
const seg = 'relative min-w-0'
// A divider between two segments fades while the segment on either side is hovered or focused.
const divider =
  'h-8 w-px shrink-0 bg-border transition-opacity max-md:hidden [:hover+&]:opacity-0 [:focus-within+&]:opacity-0 [&:has(+:hover)]:opacity-0 [&:has(+:focus-within)]:opacity-0'
const segLabel = 'pointer-events-none absolute top-2.5 left-6 text-xs font-semibold text-foreground max-md:left-4'
const segSelect =
  'block h-full min-h-15 w-full cursor-pointer appearance-none truncate rounded-full bg-transparent pt-6 pr-6 pb-2.5 pl-6 text-md text-foreground hover:bg-muted focus-visible:outline-offset-[-2px] max-md:min-h-14 max-md:rounded-xl max-md:pl-4 placeholder:text-muted-foreground data-empty:text-muted-foreground [&:has(option[value=""]:checked)]:text-muted-foreground'
const description =
  'A free directory of funding for nature restoration and conservation. Every deadline, amount and eligibility rule links to the funder’s own page, with the words it rests on and the date we read it.'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absolute('/'),
    description,
    publisher: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Grants and funding for nature restoration and conservation',
    description:
      'Funding programmes and calls for nature restoration and conservation. Each fact carries the funder page it was read from, a verbatim quote and the date it was checked.',
    url: absolute('/'),
    license: 'https://creativecommons.org/licenses/by/4.0/',
    isAccessibleForFree: true,
    creator: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
    dateModified: stats.lastChecked ?? undefined,
    keywords: ['restoration grants', 'conservation funding', 'reforestation grants', 'mangrove funding'],
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: absolute('/data.json') },
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: absolute('/data.csv') },
    ],
  },
]
---

<Base
  title="naturefunding.org: funding for nature restoration, checked against each funder’s page"
  description={description}
  path="/"
  nav="finder"
  jsonLd={jsonLd}
>
  <div slot="band" class="pb-6 max-md:pb-4">
    {/* What the site is, on the green, over the questions that narrow it down. */}
    <div class="wrap pt-2 pb-5 text-center max-md:pt-1 max-md:pb-4 max-md:text-left">
      <h1 class="mx-auto max-w-[38ch] text-balance text-[clamp(1.375rem,1rem+1.1vw,2rem)] leading-[1.15] tracking-[-0.01em] text-shell-ink">Funding for nature restoration and conservation, checked against each funder’s own page.</h1>
      <p class="mx-auto mt-2 max-w-[78ch] text-sm text-balance text-shell-ink-2">
        <span class="max-md:hidden">Every deadline, amount and eligibility rule links to the funder’s own page, with the words it rests on and the date we read it.</span>{' '}
        Free, with no paid listings or paid ranking. Built openly by Restoration Scope.
        {stats.lastChecked && <span class="max-md:hidden"> Last checked {longDate(stats.lastChecked)}.</span>}
      </p>
    </div>
    {/* Project types, like the category row of a booking site. Links, so they work without JavaScript too. */}
    <nav class="wrap flex justify-center gap-x-7 overflow-x-auto [scrollbar-width:none] max-lg:justify-start max-md:gap-x-5" aria-label="Project types">
      {
        types.map(({ label, Icon, cat, href }) => (
          <a
            class="flex shrink-0 flex-col items-center gap-1 border-b-2 border-transparent pt-1 pb-2 text-sm font-medium text-shell-ink-2! no-underline hover:border-shell-ink-2/50 hover:text-shell-ink! aria-[current=true]:border-shell-ink aria-[current=true]:text-shell-ink!"
            href={href}
            data-cat={cat}
            aria-current={cat === '' ? 'true' : undefined}
          >
            <Icon className="size-6" strokeWidth={1.5} aria-hidden="true" />
            {label}
          </a>
        ))
      }
    </nav>
    {/* Where, when and who: each sets a filter below (src/lib/finder.ts). Without JavaScript the form sends
        them in the address, and the full list stays below. */}
    <div class="wrap mt-4">
      <form
        class="mx-auto flex max-w-[54rem] items-center rounded-full bg-card p-1.5 text-foreground shadow-[0_8px_28px_rgb(0_0_0/0.25)] max-md:grid max-md:grid-cols-2 max-md:rounded-2xl max-md:p-1"
        action="/#results"
        method="get"
        aria-label="Search funding"
        data-ask
      >
        <div class:list={[seg, 'flex-[1.4] max-md:col-span-2 max-md:border-b max-md:border-border']}>
          <label class={segLabel} for="ask-where">Where</label>
          <select id="ask-where" name="where" class={segSelect}>
            <option value="">Anywhere</option>
            <optgroup label="Regions">
              {countriesByRegion.map((r) => <option value={`r:${r.region}`}>{r.label}</option>)}
            </optgroup>
            {
              countriesByRegion.map((r) => (
                <optgroup label={r.label}>
                  {r.countries.map((c) => <option value={c.code}>{c.name}</option>)}
                </optgroup>
              ))
            }
          </select>
        </div>
        <span class={divider} aria-hidden="true"></span>
        <div class:list={[seg, 'flex-1']}>
          <label class={segLabel} for="ask-within">When</label>
          <select id="ask-within" name="within" class={segSelect}>
            <option value="">Any deadline</option>
            <option value="7">Closes within 7 days</option>
            <option value="30">Within 30 days</option>
            <option value="90">Within 90 days</option>
          </select>
        </div>
        <span class={divider} aria-hidden="true"></span>
        <div class:list={[seg, 'flex-1 max-md:border-l max-md:border-border']}>
          <label class={segLabel} for="ask-applicant">Who</label>
          <select id="ask-applicant" name="applicant" class={segSelect}>
            <option value="">Anyone</option>
            {usedApplicants.map(([k, label]) => <option value={k}>{label}</option>)}
            {/* Shown when the filters below pick more than one. */}
            <option value="multi" hidden data-ask-multi></option>
          </select>
        </div>
        <Button type="submit" className="mr-1.5 ml-1.5 h-12 shrink-0 rounded-full px-5 max-md:col-span-2 max-md:m-1 max-md:mt-1.5 max-md:h-11 max-md:rounded-xl">
          <Search className="size-5!" aria-hidden="true" /><span>Search</span>
        </Button>
      </form>
    </div>
  </div>

  <div class="wrap mt-5 grid grid-cols-[minmax(0,1fr)] gap-3 xl:mt-6 xl:grid-cols-[15.375rem_minmax(0,1fr)] xl:gap-3">
    <a class={skipLink} href="#results">Skip to results</a>
    {/* Wide screens: the filters ride in a sticky column. Phones and tablets: they open in a sheet.
        The scroller's own padding keeps every focus ring inside it (the ring reaches 5px out), and its 1rem
        right lane, with the gutter reserved, keeps an overlay scrollbar (macOS) or a classic one (Windows)
        off the counts and chevrons. The column is 14rem of filters plus that padding. */}
    <form
      class="xl:sticky xl:top-0 xl:max-h-dvh xl:self-start xl:overflow-y-auto xl:pt-2 xl:pr-4 xl:pb-6 xl:pl-1.5 xl:[scrollbar-gutter:stable] xl:[scrollbar-width:thin]"
      role="search"
      aria-label="Search and filter funding"
      data-form
    >
      <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-2 xl:grid-cols-[minmax(0,1fr)] xl:pt-1">
        <Label htmlFor="q" className="col-span-full mb-[0.3rem] max-xl:sr-only">Search</Label>
        <Input id="q" name="q" type="search" placeholder="Search funder or place" autoComplete="off" />
        <button
          type="button"
          class="inline-flex min-h-10 cursor-pointer items-center gap-2 rounded-md border border-input bg-card px-3 text-md font-semibold text-foreground shadow-xs hover:bg-muted xl:hidden!"
          data-sheet-open
          aria-controls="filters"
          aria-expanded="false"
        >
          <SlidersHorizontal className="size-4" aria-hidden="true" />
          Filters <Badge variant="count" data-filter-count="" hidden />
        </button>
      </div>

      <div class="fixed inset-0 z-29 bg-backdrop xl:hidden!" data-backdrop hidden></div>
      <div
        class="max-xl:fixed max-xl:inset-x-0 max-xl:bottom-0 max-xl:z-30 max-xl:flex max-xl:max-h-[calc(100dvh-1.5rem)] max-xl:flex-col max-xl:rounded-t-xl max-xl:bg-ground max-xl:shadow-[0_-8px_32px_rgb(0_0_0/0.3)] max-xl:not-data-open:hidden md:max-xl:inset-y-0 md:max-xl:left-auto md:max-xl:max-h-none md:max-xl:w-[26rem] md:max-xl:rounded-none md:max-xl:rounded-l-xl xl:mt-3"
        id="filters"
        data-sheet
        aria-label="Filters"
      >
        <div class="flex items-center justify-between border-b border-rule pt-[0.6rem] pr-2 pb-[0.4rem] pl-4 xl:hidden!">
          <h2 class="text-2xl">Filters</h2>
          <button type="button" class="grid size-11 cursor-pointer place-items-center rounded-md text-foreground hover:bg-muted" data-sheet-close aria-label="Close filters">
            <X className="size-5" aria-hidden="true" />
          </button>
        </div>

        <div class="max-xl:flex-1 max-xl:overflow-y-auto max-xl:overscroll-contain max-xl:px-4">
          {/* Sorting sits in the sheet on phones and tablets; wide screens sort from the table header. */}
          <div class="border-b border-rule py-3 xl:hidden">
            <Label htmlFor="sort" className="mb-[0.3rem]">Sort by</Label>
            <NativeSelect id="sort" data-sort-select="">
              <option value="deadline">Soonest deadline</option>
              <option value="amount">Largest amount</option>
              <option value="checked">Recently checked</option>
            </NativeSelect>
          </div>
          <fieldset class={group} data-group="status">
            <legend class={groupTitle}>Status<Badge variant="count" data-gcount="status" hidden /></legend>
            <div>
              {
                states.map((s) => (
                  <>
                    {/* The counts are honest totals; these two sit folded on the page until asked for. */}
                    {s === 'none' && <p class="mt-2 mb-1 border-t border-border pt-2 text-xs text-muted-foreground">Folded under “Not open now”</p>}
                    <label class={opt}>
                      <input class={optInput} type="checkbox" name="status" value={s} />
                      <span class={optText}>{stateFilterLabels[s]}</span>
                      <span class={optN} data-n={`status:${s}`}>{count(s)}</span>
                    </label>
                  </>
                ))
              }
            </div>
          </fieldset>

          <fieldset class={group} data-group="within">
            <legend class={groupTitle}>Deadline<Badge variant="count" data-gcount="within" hidden /></legend>
            <div>
              <label class={opt}><input class={optInput} type="radio" name="within" value="" checked /><span class={optText}>Any time</span></label>
              <label class={opt}><input class={optInput} type="radio" name="within" value="7" /><span class={optText}>Closes within 7 days</span></label>
              <label class={opt}><input class={optInput} type="radio" name="within" value="30" /><span class={optText}>Within 30 days</span></label>
              <label class={opt}><input class={optInput} type="radio" name="within" value="90" /><span class={optText}>Within 90 days</span></label>
            </div>
          </fieldset>

          <div class={group} data-group="where">
            <label class={groupTitle} for="where">Where the project is<Badge variant="count" data-gcount="where" hidden /></label>
            <div>
              <NativeSelect id="where" name="where">
                <option value="">Anywhere</option>
                <optgroup label="Regions">
                  {countriesByRegion.map((r) => <option value={`r:${r.region}`}>{r.label}</option>)}
                </optgroup>
                {
                  countriesByRegion.map((r) => (
                    <optgroup label={r.label}>
                      {r.countries.map((c) => (
                        <option value={c.code} data-region={r.region}>{c.name}</option>
                      ))}
                    </optgroup>
                  ))
                }
              </NativeSelect>
              <p class={groupHint}>Programmes that may fund there, worldwide ones included. Each call sets its own countries.</p>
            </div>
          </div>

          <fieldset class={group} data-group="access">
            <legend class={groupTitle}>How to apply<Badge variant="count" data-gcount="access" hidden /></legend>
            <div>
              {
                routes.map(([k, label]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="access" value={k} />
                    <span class={optText}>{label}</span>
                    <span class={optN} data-n={`access:${k}`} />
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class={group} data-group="size">
            <legend class={groupTitle}>Grant size<Badge variant="count" data-gcount="size" hidden /></legend>
            <div>
              {
                Object.entries(sizeBuckets).map(([k, b]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="size" value={k} />
                    <span class={optText}>{b.label}</span>
                    <span class={optN} data-n={`size:${k}`} />
                  </label>
                ))
              }
              <p class={groupHint}>Converted roughly to US dollars, only for this filter.</p>
            </div>
          </fieldset>

          <fieldset class={group} data-group="applicant">
            <legend class={groupTitle}>Who can apply<Badge variant="count" data-gcount="applicant" hidden /></legend>
            <div>
              {
                usedApplicants.map(([k, label]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="applicant" value={k} />
                    <span class={optText}>{label}</span>
                    <span class={optN} data-n={`applicant:${k}`} />
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class={group} data-group="approach">
            <legend class={groupTitle}>Approach<Badge variant="count" data-gcount="approach" hidden /></legend>
            <div>
              {
                usedApproaches.map(([k, label]) => (
                  <label class={opt}>
                    <input class={optInput} type="checkbox" name="approach" value={k} />
                    <span class={optText}>{label}</span>
                    <span class={optN} data-n={`approach:${k}`} />
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <div class="flex items-center gap-3 border-t border-rule bg-surface px-4 pt-[0.65rem] pb-[calc(0.65rem+env(safe-area-inset-bottom))] xl:hidden!">
          <button type="button" class="min-h-11 cursor-pointer px-2 text-link underline underline-offset-[0.18em]" data-reset>Clear all</button>
          <Button className="flex-1" data-sheet-done="">Show {sorted.length} results</Button>
        </div>
      </div>
    </form>

    {/* The results are a container: the summary, the bar and the table reflow by their own width. */}
    <section class="results @container/tbl min-w-0" id="results" tabindex="-1" aria-labelledby="summary">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pb-3 @max-[40rem]/tbl:gap-y-1.5 @max-[40rem]/tbl:pb-2">
        {/* The summary is the quick filter. */}
        <h2
          id="summary"
          class="flex flex-wrap items-center gap-2 font-sans text-base leading-[1.3] font-normal [text-wrap:initial] @max-[40rem]/tbl:mx-[calc(var(--gutter)*-1)] @max-[40rem]/tbl:snap-x @max-[40rem]/tbl:scroll-px-(--gutter) @max-[40rem]/tbl:flex-nowrap @max-[40rem]/tbl:overflow-x-auto @max-[40rem]/tbl:px-(--gutter) @max-[40rem]/tbl:py-1 @max-[40rem]/tbl:[scrollbar-width:none]"
          data-summary
        >
          <button type="button" class={quick} data-quick="status:open" aria-pressed="false"><span data-ql="open">Open now</span> <b class={quickN} data-qn="open">{count('open')}</b></button>
          <button type="button" class={quick} data-quick="within:7" aria-pressed="false">Closing within 7 days <b class={`${quickNBase} bg-warn text-warn-ink`} data-qn="soon">0</b></button>
          <button type="button" class={quick} data-quick="status:rolling" aria-pressed="false">Rolling <b class={quickN} data-qn="rolling">{count('rolling')}</b></button>
          <button type="button" class={quick} data-quick="status:upcoming" aria-pressed="false">Upcoming <b class={quickN} data-qn="upcoming">{count('upcoming')}</b></button>
          <span class="mx-1 h-5 w-px shrink-0 bg-border" aria-hidden="true" data-later-sep></span>
          <button
            type="button"
            class="group/later inline-flex h-8 shrink-0 pointer-coarse:h-10 cursor-pointer snap-start items-center gap-1.5 rounded-md px-2.5 text-sm font-medium whitespace-nowrap text-muted-foreground hover:bg-muted hover:text-foreground disabled:cursor-default disabled:opacity-50 aria-pressed:text-foreground"
            data-later-toggle
            aria-pressed="false"
            aria-controls="later-head later-rows"
          >
            <ChevronDown className="size-4 transition-transform group-aria-pressed/later:rotate-180" aria-hidden="true" /><span data-later-verb>Show</span> <b class:list={[num, 'font-semibold']} data-qn="later">{later.length}</b> not open now
          </button>
        </h2>
        {/* Its own line, left, right above the table it describes. */}
        <p class="flex basis-full flex-wrap items-baseline gap-x-3 text-sm text-muted-foreground">
          <span class="whitespace-nowrap text-foreground tabular-nums" data-shown>{now.length} of {sorted.length} shown</span>
          <span data-sort-line>Open calls first, soonest deadline first</span>
        </p>
      </div>
      <p class="sr-only" aria-live="polite" data-live></p>
      <div class="flex flex-wrap gap-1.5 pb-3" data-chips hidden></div>

      {/* shadcn/ui Table in a Card; on phones each row becomes its own card (src/styles/finder.css). */}
      <div class="tbl-wrap" data-table>
      <Table className="tbl">
        <TableCaption className="sr-only">Funding programmes. Sortable by deadline, amount and date checked.</TableCaption>
        <TableHeader>
          <TableRow>
            <TableHead scope="col" className="h-prog">Programme and funder</TableHead>
            <TableHead scope="col" className="h-dl" aria-sort="ascending" data-col="deadline">
              <button type="button" data-sort="deadline">Status and deadline <span class="arrow" aria-hidden="true"><ChevronsUpDown className="i-none" /><ArrowUp className="i-asc" /><ArrowDown className="i-desc" /></span></button>
            </TableHead>
            <TableHead scope="col" className="h-amount" data-col="amount">
              <button type="button" data-sort="amount">Amount <span class="arrow" aria-hidden="true"><ChevronsUpDown className="i-none" /><ArrowUp className="i-asc" /><ArrowDown className="i-desc" /></span></button>
              <button type="button" class="h-alt" data-sort="checked" data-alt-for="checked">Checked <span class="arrow" aria-hidden="true"><ChevronsUpDown className="i-none" /><ArrowUp className="i-asc" /><ArrowDown className="i-desc" /></span></button>
            </TableHead>
            <TableHead scope="col" className="h-rc" data-col="checked">
              <span class="h-route">Route</span>
              <button type="button" data-sort="checked">Checked <span class="arrow" aria-hidden="true"><ChevronsUpDown className="i-none" /><ArrowUp className="i-asc" /><ArrowDown className="i-desc" /></span></button>
            </TableHead>
          </TableRow>
        </TableHeader>
        <TableBody data-list="">
          {now.map((l) => <Row listing={l} />)}
        </TableBody>
        <TableBody className="later-head" id="later-head" data-later-head="" hidden>
          <TableRow>
            <TableHead colSpan={4} scope="colgroup">
              <span class="later-head__title">Not open now</span>
              <span class="later-head__hint">No call found, or closed. Listed so you can plan ahead.</span>
              <button type="button" class="linkish" data-later-hide>Hide</button>
            </TableHead>
          </TableRow>
        </TableBody>
        <TableBody className="later-rows" id="later-rows" data-list-later="" hidden>
          {later.map((l) => <Row listing={l} />)}
        </TableBody>
      </Table>
      </div>

      <button
        type="button"
        class="mt-4 flex min-h-12 w-full cursor-pointer flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-lg border border-border bg-card px-4 py-[0.6rem] text-left text-foreground shadow-xs hover:bg-muted"
        data-later-toggle
        data-endfold
        aria-controls="later-head later-rows"
        aria-pressed="false"
      >
        <span class="font-bold">Not open now</span>
        <span class="font-semibold text-link underline underline-offset-[0.18em]">Show all <b class={num} data-qn-end>{later.length}</b></span>
      </button>

      {/* A line for the weekly email signup can go here, under the list (a separate piece of work). */}

      <div class="px-2 py-8" data-empty hidden>
        <h3 class="text-2xl" data-empty-head>Nothing matches.</h3>
        <p class="mt-[0.4rem] text-ink-2" data-empty-text>Try another search, remove a filter, or <button type="button" class="linkish" data-reset>clear all</button>.</p>
      </div>
      <noscript>
        <p class="pt-4 text-ink-2">Filters and sorting need JavaScript. Calls open now are listed above, soonest deadline first.</p>
      </noscript>
    </section>
  </div>
</Base>

<script>
  import { initTableFinder } from '../lib/finder'
  initTableFinder()
</script>
