---
import Base from '../layouts/Base.astro'
import Finder from '../components/Finder.astro'
import { listings, sortListings, stats } from '../lib/data'
import { longDate } from '../lib/format'
import { SITE_NAME, absolute } from '../lib/site'
import { homeItemListLd } from '../lib/agent'

const sorted = [...listings].sort(sortListings)
const description = `${stats.programmes} restoration and conservation grants, ${stats.open} open now. Every deadline and rule links to the funder’s own page. Free, with no paid listings.`

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absolute('/'),
    description,
    publisher: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Grants and funding for nature restoration and conservation',
    description:
      'Funding programmes and calls for nature restoration and conservation. Each fact carries the funder page it was read from, a verbatim quote and the date it was checked.',
    url: absolute('/'),
    license: 'https://creativecommons.org/licenses/by/4.0/',
    isAccessibleForFree: true,
    creator: { '@type': 'Organization', name: 'Restoration Scope', url: 'https://restorationscope.com' },
    dateModified: stats.lastChecked ?? undefined,
    keywords: ['restoration grants', 'conservation funding', 'reforestation grants', 'mangrove funding'],
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: absolute('/data.json') },
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: absolute('/data.csv') },
    ],
  },
  homeItemListLd(sorted),
]
---

<Base
  title="Grants for nature restoration and conservation | naturefunding.org"
  description={description}
  path="/"
  nav="finder"
  jsonLd={jsonLd}
>
  <div slot="band" class="pb-[6.5rem] max-md:pb-16">
    {/* What the site is, on the green: the title on the left, the words beside it. */}
    <div class="wrap grid items-end gap-x-14 gap-y-3 pt-3 lg:grid-cols-[5fr_7fr] max-md:pt-1">
      <h1 class="text-balance text-[clamp(1.875rem,1.2rem+1.4vw,2.5rem)] leading-[1.08] tracking-[-0.01em] text-shell-ink">Grants for nature restoration and conservation</h1>
      <p class="text-[0.9375rem] leading-[1.55] text-shell-ink-2">
        {/* Answers "what is this" on its own, for search snippets and AI answers; phones keep the first two sentences. */}
        <span class="text-shell-ink">{`${stats.programmes} grants and funding programmes for nature restoration and conservation: forests and tree planting, coasts, wetlands, wildlife and more. ${stats.open} ${stats.open === 1 ? 'is' : 'are'} open now.`}</span>{' '}
        <span class="max-md:hidden">
          For nonprofits and community groups leading projects on the ground. Every deadline, amount and eligibility rule links to the funder’s own page, with its exact words and the date we checked it. Free: funders can’t pay to be listed.
          {stats.lastChecked && ` Last checked ${longDate(stats.lastChecked)}.`}
        </span>
      </p>
    </div>
  </div>

  <Finder listings={listings} />
</Base>
