---
// Fiscal sponsors (data/sponsors) and the listed grants that say whether they take one.
import Base from '../layouts/Base.astro'
import SponsorCard from '../components/SponsorCard.astro'
import SponsorRow from '../components/SponsorRow.astro'
import { Table, TableCaption, TableHead, TableHeader, TableRow } from '@/components/ui/table'
import { sponsorTypes, type SponsorType } from '../data/sponsors'
import { programmes, sponsors } from '../lib/data'
import { programmeTitle } from '../lib/format'
import { sponsorTypeLabels } from '../lib/labels'
import { absolute, RS_ORG } from '../lib/site'

const countries = new Set(sponsors.map((s) => s.country.value)).size
const description = `${sponsors.length} fiscal sponsors in ${countries} countries for nature projects and the tools they need, by type of project: what each takes, charges and asks for, in its own words.`
const groups = sponsorTypes
  .map((type) => ({ type, label: sponsorTypeLabels[type], list: sponsors.filter((s) => s.types.some((t) => t.value === type)) }))
  .filter((g) => g.list.length > 0)
const anySubject: SponsorType[] = ['environment', 'any']
const broad = groups.filter((g) => anySubject.includes(g.type))
const columns = ['Sponsor', 'Takes', 'Charges', 'Groups abroad', 'Companies', 'Individuals']
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Fiscal sponsors for nature projects',
  url: absolute('/fiscal-sponsors/'),
  description,
  publisher: RS_ORG,
}
const by = (stance: string) =>
  programmes.filter((p) => p.fiscal_sponsor?.stance === stance).sort((a, b) => a.name.localeCompare(b.name, 'en'))
const accepted = by('accepted')
const refused = [...by('refused'), ...by('discouraged')]
const grantList = 'm-0 grid list-none gap-x-8 gap-y-2 p-0 md:grid-cols-2'
const h2 = 'mt-12 mb-3 scroll-mt-6 text-3xl font-extrabold'
---

<Base title="Fiscal sponsors for nature projects" description={description} path="/fiscal-sponsors/" jsonLd={jsonLd} allGrants>
  <div slot="band" class="wrap pt-7 pb-9">
    <h1 class="text-[clamp(1.75rem,1.2rem+2.2vw,2.75rem)] font-extrabold tracking-[-0.02em]">Fiscal sponsors for nature projects</h1>
    <p class="mt-[0.9rem] max-w-[60ch] text-xl text-shell-ink-2">
      Some funders pay only registered charities. A fiscal sponsor is an organisation that can receive or manage funding
      for a project, depending on the arrangement and the funder’s rules.
    </p>
  </div>

  <div class="wrap pb-4">
    <div class="mt-8 [&>p]:max-w-[66ch] [&>p+p]:mt-[0.85rem]">
        <p>
          {sponsors.length} sponsors, by type of project. Within a type they are in alphabetical order; none pays to be here or is ranked.
          Each fact comes from the sponsor’s own pages. “Not said” means we didn’t find it there: ask before you count on it.
        </p>
        <p>
          For a particular grant, check whether the funder accepts applying through a sponsor. <a href="#grants">{accepted.length} grants here say they do, and {refused.length} refuse or discourage it</a>.
        </p>
    </div>

    <nav aria-label="Types of project" class="mt-6" data-toc>
      <p class="text-md font-bold">What is your project about?</p>
      <ul class="mt-2 mb-0 flex list-none flex-wrap gap-2 p-0">
        {groups.map((g) => (
          <li>
            <a href={`#takes-${g.type}`} class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-rule bg-chip px-3.5 text-md font-medium no-underline hover:underline">
              {g.label}<span class="text-sm text-ink-2 tabular-nums">{g.list.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {groups.map((g) => (
      <section aria-labelledby={`takes-${g.type}`}>
        <h2 id={`takes-${g.type}`} class={h2}>{g.label}</h2>
        {!anySubject.includes(g.type) && (
          <p class="mb-3 text-md text-ink-2">
            Also check {broad.map((b, i) => <Fragment>{i > 0 && ' and '}<a href={`#takes-${b.type}`}>{b.label.toLowerCase()}</a></Fragment>)}: sponsors there name no single subject.{g.type === 'hardware' && <Fragment> <a href="#takes-software">{sponsorTypeLabels.software}</a> has a sponsor that takes open source projects of all kinds.</Fragment>}
          </p>
        )}
        <div class="sp-wrap">
          <Table className="sp-tbl">
            <TableCaption className="sr-only">Fiscal sponsors: {g.label}</TableCaption>
            <TableHeader>
              <TableRow>
                {columns.map((c) => <TableHead scope="col">{c}</TableHead>)}
                <TableHead scope="col" data-twin-skip><span class="sr-only">Details</span></TableHead>
              </TableRow>
            </TableHeader>
            {g.list.map((s) => <SponsorRow s={s} />)}
          </Table>
        </div>
      </section>
    ))}

    <h2 id="sponsors" class={h2}>Every fact, sponsor by sponsor</h2>
    <p class="max-w-[66ch] text-ink-2">
      With the sponsor’s own words and the day we read them. Also ask who employs your people, and who owns what the project makes.
    </p>
    <div class="mt-5 grid grid-cols-[minmax(0,1fr)] gap-4">
      {sponsors.map((s) => <SponsorCard s={s} />)}
    </div>

    <h2 id="grants" class={h2}>What funders say</h2>
    <p class="max-w-[66ch] text-ink-2">
      The grants listed here where we recorded what the funder says about applying through a sponsor. For any other, ask the funder.
    </p>
    <h3 class="mt-7 mb-2 text-xl font-bold">Accepted ({accepted.length})</h3>
    <ul class={grantList}>
      {accepted.map((p) => <li><a href={`/p/${p.id}/#fiscal_sponsor`}>{programmeTitle(p)}</a></li>)}
    </ul>
    <h3 class="mt-7 mb-2 text-xl font-bold">Refused or discouraged ({refused.length})</h3>
    <ul class={grantList}>
      {refused.map((p) => <li><a href={`/p/${p.id}/#fiscal_sponsor`}>{programmeTitle(p)}</a></li>)}
    </ul>
  </div>
</Base>

<style is:global>
  /* The same card and table as the finder's (src/styles/finder.css). overflow: clip rounds the corners without
     making a scroll box, so the header still sticks to the page. One tbody per sponsor: its row and its details. */
  .sp-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    overflow: clip;
  }
  .sp-tbl {
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .sp-tbl thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    width: 11%;
    height: 2.5rem;
    padding: 0 0.75rem;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    font-weight: 500;
    color: var(--muted-foreground);
    vertical-align: middle;
  }
  .sp-tbl thead th:nth-child(1) {
    width: 16%;
  }
  .sp-tbl thead th:nth-child(2) {
    width: 27%;
  }
  .sp-tbl thead th:nth-child(3) {
    width: 15.5%;
  }
  .sp-tbl thead th:nth-child(4) {
    width: 12%;
  }
  .sp-tbl thead th:last-child {
    width: 7.5%;
  }
  .sp-tbl tbody :is(th, td) {
    padding: 0.65rem 0.75rem;
    font-weight: 400;
    text-align: left;
    vertical-align: top;
    overflow-wrap: break-word;
  }
  .sp-tbl tbody + tbody > tr:first-child > :is(th, td) {
    border-top: 1px solid var(--border);
  }
  .sp-tbl td > p + p {
    margin-top: 0.25rem;
  }
  .sp-tbl strong,
  .sp-answer {
    font-weight: 600;
  }
  .sp-name {
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
  }
  .sp-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    align-items: center;
    margin-top: 0.125rem;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .sp-answer {
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }
  .sp-mark {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    stroke-width: 2.75;
  }
  .sp-open {
    padding-left: 0 !important;
  }
  .sp-open summary {
    display: flex;
    gap: 0.2rem;
    align-items: center;
    justify-content: flex-end;
    color: var(--link);
    list-style: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .sp-open summary::-webkit-details-marker {
    display: none;
  }
  .sp-open summary > svg {
    width: 1rem;
    height: 1rem;
  }
  .sp-open details[open] svg {
    transform: rotate(180deg);
  }
  .sp-tbl .sp-more {
    display: none;
  }
  .sp-tbl tbody:has([data-sp-toggle][open]) .sp-more {
    display: table-row;
  }
  .sp-tbl tbody:has([data-sp-toggle][open]) > tr > * {
    background: color-mix(in oklch, var(--ground) 55%, var(--card));
  }
  .sp-tbl .sp-more > td {
    padding-bottom: 1rem;
  }
  .sp-more__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem 2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .sp-more__label {
    margin-bottom: 0.2rem;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .sp-more :is(ol, ul) {
    margin: 0;
    padding-left: 1.15rem;
  }
  .sp-more li + li {
    margin-top: 0.15rem;
  }
  @media (hover: hover) {
    .sp-name:hover,
    .sp-open summary:hover {
      text-decoration: underline;
    }
    .sp-tbl tbody:hover > tr:first-child > * {
      background: color-mix(in oklch, var(--ground) 55%, var(--card));
    }
  }

  /* Narrow: one card per sponsor, its answers labelled; a question it doesn't answer takes one line. */
  @media (max-width: 59.99rem) {
    .sp-wrap {
      border: 0;
      background: none;
      overflow: visible;
    }
    .sp-tbl thead {
      display: none;
    }
    .sp-tbl,
    .sp-tbl tbody {
      display: block;
    }
    .sp-tbl tbody {
      padding: 0.4rem 0;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--card);
      overflow: clip;
    }
    .sp-tbl tbody + tbody {
      margin-top: 0.75rem;
    }
    .sp-tbl tbody > tr:first-child {
      display: block;
    }
    .sp-tbl tbody > tr > * {
      display: block;
      padding: 0.35rem 1rem !important;
      border: 0 !important;
      background: none !important;
    }
    .sp-tbl tbody > tr:first-child > td[data-label] {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      column-gap: 0.75rem;
    }
    .sp-tbl td[data-label] > * {
      grid-column: 2;
    }
    .sp-tbl td[data-label]::before {
      content: attr(data-label);
      grid-column: 1;
      grid-row: 1;
      color: var(--muted-foreground);
    }
    .sp-open summary {
      justify-content: flex-start;
      min-height: 2.75rem;
    }
    .sp-tbl tbody:has([data-sp-toggle][open]) .sp-more {
      display: block;
    }
  }
</style>
