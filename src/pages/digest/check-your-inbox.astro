---
import Base from '../../layouts/Base.astro'

---

<Base title="Check your inbox" description="Confirm your address to start the weekly naturefunding.org email." path="/digest/check-your-inbox/" noindex>
  <div slot="band" class="wrap pt-8 pb-10">
    <h1 class="text-[clamp(1.75rem,1.2rem+2.2vw,2.75rem)] font-extrabold tracking-[-0.02em]">Check your inbox</h1>
    <p class="mt-3 max-w-[60ch] text-xl text-shell-ink-2">We sent you a link to confirm your address. Press it to start the weekly email.</p>
  </div>
  <div class="wrap mt-10">
    <p class="max-w-[60ch]">The link works for 3 days. Nothing there? Check your spam folder, or <a href="/digest/">sign up again</a> in an hour.</p>
    <p class="mt-6"><a href="/">Back to all funding</a></p>
  </div>
</Base>
