---
import Base from '../../layouts/Base.astro'

---

<Base title="You’re subscribed" description="Your weekly naturefunding.org email is on." path="/digest/subscribed/" noindex>
  <div slot="band" class="wrap pt-8 pb-10">
    <h1 class="text-[clamp(1.75rem,1.2rem+2.2vw,2.75rem)] font-extrabold tracking-[-0.02em]">You’re subscribed</h1>
    <p class="mt-3 max-w-[60ch] text-xl text-shell-ink-2">Your first email comes the first week something new matches your choices.</p>
  </div>
  <div class="wrap mt-10">
    <p class="max-w-[60ch]">At most one email a week, and only when there is something new. Every email has a one-click unsubscribe link. To change your choices, <a href="/digest/">sign up again</a> with the new ones.</p>
    <p class="mt-6"><a href="/">Back to all funding</a></p>
  </div>
</Base>
