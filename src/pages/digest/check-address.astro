---
import Base from '../../layouts/Base.astro'
import DigestSignup from '../../components/DigestSignup.astro'
---

<Base title="Check the email address" description="The weekly naturefunding.org email needs a working address." path="/digest/check-address/" noindex>
  <div slot="band" class="wrap pt-8 pb-10">
    <h1 class="text-[clamp(1.75rem,1.2rem+2.2vw,2.75rem)] font-extrabold tracking-[-0.02em]">Check the email address</h1>
    <p class="mt-3 max-w-[60ch] text-xl text-shell-ink-2">That doesn’t look like an email address. Type it again and we’ll send the confirmation link.</p>
  </div>
  <div class="wrap mt-10">
    <DigestSignup />
  </div>
</Base>
