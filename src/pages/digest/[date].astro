---
// A past weekly email: one page per week (digest/scripts/issues.ts), linked from /digest/.
import Base from '../../layouts/Base.astro'
import DigestIssue from '../../components/DigestIssue.astro'
import DigestSignup from '../../components/DigestSignup.astro'
import { pastIssues, type Issue } from '../../../digest/scripts/issues'
import { countsText } from '../../../digest/src/email'
import { longDate } from '../../lib/format'

export function getStaticPaths() {
  const issues = pastIssues()
  return issues.map((issue, n) => ({ params: { date: issue.date }, props: { issue, newer: issues[n - 1] ?? null, older: issues[n + 1] ?? null } }))
}

interface Props {
  issue: Issue
  newer: Issue | null
  older: Issue | null
}

const { issue, newer, older } = Astro.props
const date = longDate(issue.date)
const summary = countsText(issue.digest.counts)
const span = issue.since ? `since ${longDate(issue.since.slice(0, 10))}` : 'since launch'
const link = 'text-link underline underline-offset-2'
---

<Base title={`Weekly email, ${date}`} description={`New nature funding ${span}: ${summary}.`} path={`/digest/${issue.date}/`} nav="digest">
  <div slot="band" class="wrap pt-8 pb-10">
    <a class="text-sm text-shell-ink-2 underline underline-offset-2" href="/digest/">Weekly email</a>
    <h1 class="mt-2 text-[clamp(1.75rem,1.2rem+2.2vw,2.75rem)] font-extrabold tracking-[-0.02em]">{date}</h1>
    <p class="mt-3 max-w-[60ch] text-xl text-shell-ink-2">New {span}: {summary}.</p>
  </div>
  <div class="wrap mt-10 grid gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,40rem)_minmax(0,1fr)]">
    <div>
      <p class="mb-8 max-w-[60ch] text-ink-2">
        What was new that week, as the email lists it for someone who picks no country or type of project, with the
        listings as they stood on {date}. Calls, amounts and deadlines may have changed since: each listing has today’s.
      </p>
      <DigestIssue issue={issue} />
      <nav class="mt-10 flex flex-wrap justify-between gap-4" aria-label="Other weeks">
        {older ? <a class={link} href={`/digest/${older.date}/`}>← {longDate(older.date)}</a> : <span />}
        {newer && <a class={link} href={`/digest/${newer.date}/`}>{longDate(newer.date)} →</a>}
      </nav>
    </div>
    <div class="max-w-[36rem]">
      <h2 class="mb-4 text-2xl font-extrabold">Get it every week</h2>
      <DigestSignup id="digest-issue" />
    </div>
  </div>
</Base>
