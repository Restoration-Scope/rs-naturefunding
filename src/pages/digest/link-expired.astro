---
import Base from '../../layouts/Base.astro'
import DigestSignup from '../../components/DigestSignup.astro'
---

<Base title="This link has expired" description="A naturefunding.org email link that no longer works." path="/digest/link-expired/" noindex>
  <div slot="band" class="wrap pt-8 pb-10">
    <h1 class="text-[clamp(1.75rem,1.2rem+2.2vw,2.75rem)] font-extrabold tracking-[-0.02em]">This link has expired</h1>
    <p class="mt-3 max-w-[60ch] text-xl text-shell-ink-2">Confirmation links work for 3 days. Sign up again to get a new one.</p>
  </div>
  <div class="wrap mt-10">
    <DigestSignup />
  </div>
</Base>
