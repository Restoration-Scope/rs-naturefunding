---
import Base from '../layouts/Base.astro'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
---

<Base title="Page not found" description="This page does not exist on naturefunding.org." path="/404/">
  <div slot="band" class="wrap pt-8 pb-10">
    <h1 class="text-[2rem]">Page not found</h1>
    <p class="mt-3 max-w-[60ch] text-shell-ink-2">The programme may have been renamed or removed. Search for it, or start from the full list.</p>
  </div>
  {/* A plain GET to the finder, which reads ?q= on load: no script on this page. */}
  <div class="wrap mt-10">
    <form class="flex max-w-xl flex-wrap gap-3" action="/" method="get" role="search">
      <label class="sr-only" for="q404">Search funder or place</label>
      <Input id="q404" name="q" type="search" placeholder="Search funder or place" className="min-h-11 flex-1 basis-60" />
      <Button type="submit">Search</Button>
    </form>
    <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1 [&_a]:inline-block [&_a]:py-1.5">
      <a href="/">All funding</a>
      <a href="/about/">How we check</a>
      <a href="/about/#open-data">Open data</a>
    </p>
  </div>
</Base>
