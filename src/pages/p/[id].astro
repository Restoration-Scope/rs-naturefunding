---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import ApplyPart from '../../components/ApplyPart.astro'
import Countries from '../../components/Countries.astro'
import Fact from '../../components/Fact.astro'
import Figures from '../../components/Figures.astro'
import FactGroup from '../../components/FactGroup.astro'
import KeyFacts from '../../components/KeyFacts.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import PageContents, { type ContentsItem } from '../../components/PageContents.astro'
import Flag from '../../components/Flag.astro'
import Listing from '../../components/Listing.astro'
import OrgMark from '../../components/OrgMark.astro'
import { callFactId, callId, factIds, grantJsonLd } from '../../lib/agent'
import { primaryAction } from '../../lib/apply'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { cardClasses } from '@/components/ui/card'
import { HIDDEN_DAYS, buildDate, callGroups, whereReach, listingFor, programmeById, programmes, sortListings } from '../../lib/data'
import type { Programme } from '../../data/schema'
import { pagesFor } from '../../lib/finder-pages'
import { amountText, effortText, poolText, geographyFull, joinAnd, longDate, pageLabel, sentence, keepAmountTogether } from '../../lib/format'
import { countryName, regionLabels } from '../../lib/geo'
import {
  accessHelp,
  accessLabels,
  applicantLabels,
  approachLabels,
  stateLabels,
} from '../../lib/labels'
import { ArrowLeft, Calculator, ChevronDown } from 'lucide-react'
import WorthCheck from '../../components/WorthCheck.astro'
import { CONTACT_EMAIL, RS_REPORTING_URL, absolute, funderCorrectionUrl, reportProblemUrl } from '../../lib/site'

export const getStaticPaths = (() => programmes.map((p) => ({ params: { id: p.id }, props: { p } }))) satisfies GetStaticPaths

const { p } = Astro.props as { p: Programme }
const listing = listingFor(p)
const hidden = listing.ageDays > HIDDEN_DAYS
const { state, call } = listing
const parent = p.parent ? programmeById.get(p.parent) : undefined
const children = programmes.filter((c) => c.parent === p.id)
const childListings = children.map((c) => listingFor(c)).sort(sortListings)
// "Forest Action Facility" from "Forest Action Facility (established by IUCN and KfW)": show only what the name doesn't say.
const funderQualifier = p.funder.name.startsWith(p.name)
  ? p.funder.name.slice(p.name.length).trim().replace(/^\((.*)\)$/, '$1').replace(/^./, (ch) => ch.toUpperCase())
  : null
// An umbrella's own page often leaves these to its partner programmes.
const byPartner = childListings.length > 0 ? 'Set by each partner programme' : undefined
const openChildren = childListings.filter((l) => l.state === 'open' || l.state === 'rolling')
// Partners with no call open now fold away below the live ones, as on the finder.
const partnersNow = childListings.filter((l) => l.state !== 'none' && l.state !== 'closed')
const partnersLater = partnersNow.length > 0 ? childListings.filter((l) => !partnersNow.includes(l)) : []
const partnersShown = partnersNow.length > 0 ? partnersNow : childListings
const noCallRoute = p.access === 'intermediary' || p.access === 'invitation_only'
const amount = amountText(p.amount)
const pool = poolText(p.pool)
// The pot reads as its own fact, so it is never taken for one grant's size.
const poolValue = pool ? pool[0]!.toUpperCase() + pool.slice(1) : null
// The place and type pages this programme shows on, linked under Where and the approach.
const more = pagesFor(p)
const yesNo = (b: boolean | null) => (b === null ? null : b ? 'Yes' : 'No')
/** "America/Guayaquil" → "Ecuador Time", as the browser names it; the raw zone when it has no name. */
const zoneName = (tz: string, date: string) => {
  try {
    const name = new Intl.DateTimeFormat('en-GB', { timeZone: tz, timeZoneName: 'long' })
      .formatToParts(new Date(`${date}T12:00:00Z`))
      .find((x) => x.type === 'timeZoneName')?.value
    return name ?? tz
  } catch {
    return tz
  }
}
const deadlineText = (d: NonNullable<Programme['calls'][number]['deadline']>) =>
  `${longDate(d.date)}${d.time ? `, ${d.time}${d.timezone ? ` ${zoneName(d.timezone, d.date)}` : ''}` : ''}`
const primary = primaryAction(listing, openChildren, children.length)
// Calls that name their countries split the apply box into one part per group. The page reads the finder's
// Where (?where=CR) and narrows the box and the calls to that place; a select changes it (src/lib/where-view.ts).
const groups = callGroups(p)
const groupLabel = (codes: string[] | null) =>
  codes ? joinAnd(codes.map(countryName)) : p.geography?.scope === 'countries' ? 'Other countries' : 'Everywhere else'
const switchCountries = [...new Set(p.geography?.scope === 'countries' ? p.geography.countries : groups.flatMap((g) => g.codes ?? []))]
  .map((code) => ({ code, name: countryName(code) }))
  .sort((a, b) => a.name.localeCompare(b.name))
/** The one date a folded call shows next to its name. */
const callWhen = (c: Programme['calls'][number]) =>
  c.status === 'upcoming'
    ? c.opens
      ? `Opens ${longDate(c.opens)}`
      : c.expected
        ? `Expected ${c.expected}`
        : 'Opening date not announced yet'
    : c.deadline
      ? `${c.status === 'closed' || c.deadline.date < buildDate ? 'Closed' : 'Closes'} ${longDate(c.deadline.date)}`
      : c.status === 'open'
        ? 'No deadline stated'
        : null
const bandMark = 'mr-1.5 -mt-0.5 box-content rounded-[5px] bg-white p-0.5'
const callStatusLabel: Record<string, string> = {
  open: 'Open',
  upcoming: 'Upcoming',
  closed: 'Closed',
  suspended: 'Suspended',
  unknown: 'Not clear from the page',
}
// The call that sets the page's status comes first and open; the others fold.
// The rest follow by deadline, soonest first; undated calls last.
const byCallDeadline = (a: Programme['calls'][number], b: Programme['calls'][number]) =>
  (a.deadline?.date ?? '9999').localeCompare(b.deadline?.date ?? '9999')
const callsOrdered = call ? [call, ...p.calls.filter((c) => c !== call).sort(byCallDeadline)] : [...p.calls].sort(byCallDeadline)
// A rolling programme's open call reads as the finder says it: Rolling.
const rollingCall = (c: Programme['calls'][number]) => p.window === 'rolling' && c.status === 'open'
const callStatusText = (c: Programme['calls'][number]) =>
  rollingCall(c)
    ? 'Rolling: apply any time'
    : c.status === 'unknown' && c.recurring
      ? 'Windows each year; the page doesn’t say if one is open now'
      : callStatusLabel[c.status]

const description = `${p.name} from ${p.funder.name}: ${
  state === 'open' && call?.deadline
    ? `open, deadline ${call.deadline.text}.`
    : state === 'rolling'
      ? 'open, apply any time.'
      : noCallRoute
        ? `${accessLabels[p.access].toLowerCase()}.`
        : `${stateLabels[state].toLowerCase()}.`
} ${amount ? `${amount}. ` : ''}Each fact links to the funder’s own page.`

const grantLd = grantJsonLd(listing)
/** A line under a section title: where its quotes come from, or what it covers. */
const sectionCheck = 'mb-3 text-sm text-ink-2'
const factHelp = 'mt-1 text-md text-ink'
const oddsText = p.odds
  ? `about 1 in ${Math.round(p.odds.applied / p.odds.funded)} (${p.odds.funded.toLocaleString('en')} of ${p.odds.applied.toLocaleString('en')}, ${p.odds.period})`
  : null
// The worth-it check opens with this programme's figures filled in.
const worth = {
  amount: p.amount ? (p.amount.max ?? p.amount.min ?? null) : null,
  currency: p.amount?.currency ?? 'USD',
  steps: p.effort ? p.effort.steps.length + (p.effort.more_after ? 1 : 0) : null,
  odds: p.odds ? Math.round((p.odds.funded / p.odds.applied) * 1000) / 10 : null,
}
const listingsList = 'm-0 list-none border-t border-rule p-0'

// The left-hand contents on the widest screens: every section this page shows, in order.
const contents: ContentsItem[] = [
  // The top of the page: the summary, key facts and the apply box (which rides along in the rail anyway).
  { href: '#', label: 'Overview', kind: 'overview' },
  ...(childListings.length ? [{ href: '#partners-title', label: 'Partner programmes', kind: 'partners' } as const] : []),
  { href: '#facts-money', label: 'The money', kind: 'money' },
  { href: '#facts-who', label: 'Who can apply', kind: 'who' },
  { href: '#facts-apply', label: 'Applying', kind: 'apply' },
  ...(p.access === 'direct' ? [{ href: '#worth', label: 'Is it worth your time?', kind: 'worth' } as const] : []),
  ...(p.calls.length ? [{ href: '#calls-title', label: p.calls.length === 1 ? 'The call' : `Calls (${p.calls.length})`, kind: 'calls' } as const] : []),
  { href: '#reporting-title', label: 'Reporting', kind: 'reporting' },
  ...(parent ? [{ href: '#related-title', label: 'Larger programme', kind: 'related' } as const] : []),
]

const jsonLd = [
  ...grantLd,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Find funding', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: p.name, item: absolute(`/p/${p.id}/`) },
    ],
  },
]
---

<Base
  title={`${p.name}, ${p.funder.name}`}
  description={description}
  path={`/p/${p.id}/`}
  jsonLd={jsonLd}
  noindex={hidden}
>
  <a slot="beside-logo" class="group/back inline-flex items-center gap-1.5" href="/" data-back><ArrowLeft className="size-4 shrink-0 transition-transform group-hover/back:-translate-x-0.5" aria-hidden="true" /><span data-back-text>All funding</span></a>
  <div slot="band" class="wrap pt-4 pb-6 md:pt-5 md:pb-8 [&_a]:text-shell-ink">
    {/* Wide screens: name and funder on the left, the summary beside them. */}
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-x-12">
      <div>
        <h1 class="max-w-[30ch] text-[clamp(1.5rem,1.1rem+1.8vw,2.5rem)] leading-[1.12] tracking-[-0.01em]">{p.name}</h1>
        {/* Phones: two lines at most, so the apply box starts higher; every name stays in the Run by fact. */}
        <p class="mt-[0.6rem] text-lg text-shell-ink-2 max-md:line-clamp-2" title={p.administered_by ? `${p.funder.name}, run by ${p.administered_by.name}` : undefined}>
          {/* Marks sit on a white tile: most favicons are drawn for a light page, not the green band. */}
          {
            funderQualifier !== null ? (
              <><OrgMark org={p.funder} size={24} class={bandMark} /><a href={p.funder.url}>{funderQualifier || 'The funder’s website'}</a></>
            ) : (
              <>From <OrgMark org={p.funder} size={24} class={bandMark} /><a href={p.funder.url}>{p.funder.name}</a></>
            )
          }
          {p.administered_by && <span>, run by <OrgMark org={p.administered_by} size={20} class={bandMark} /><a href={p.administered_by.url}>{p.administered_by.name}</a></span>}
        </p>
      </div>
      <div class="lg:pt-2">
        {p.kind === 'partnership' && <p class="mt-4 font-bold lg:mt-0">Paid partnership, not a grant: the funder pays for work under a contract.</p>}
        <p class:list={['max-w-[62ch] text-lg max-md:text-base max-md:leading-[1.45]', p.kind === 'partnership' ? 'mt-[0.35rem]' : 'mt-4 max-md:mt-3 lg:mt-0']}>{p.summary}</p>
      </div>
    </div>
    {/* The flag the page puts before a country's name (src/lib/where-view.ts sets its picture). */}
    <template data-where-tpl="flag"><Flag code="ZZ" class="mr-[0.3em]" /></template>
    {/* With a Where, the page says whose view it is and how to leave it. */}
    <template data-where-tpl="chip">
      <p class="mt-4 inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg bg-shell-ink/12 px-3 py-1.5 text-md">
        <span>Showing what applies to projects in <strong data-where-name></strong></span>
        <a href="?" class="underline" data-where-clear>See every country</a>
      </p>
    </template>
  </div>

  {/* Widest screens: the page's contents on the left. */}
  <div class="min-[90rem]:mx-auto min-[90rem]:flex min-[90rem]:max-w-[calc(var(--page)+var(--contents-w)+var(--contents-gap))] min-[90rem]:px-(--gutter) min-[90rem]:gap-x-(--contents-gap)">
  <PageContents items={contents} />
  {/* Wide screens: the apply box rides along in a right rail while the facts scroll. */}
  <div data-where-codes={whereReach(p)} data-region-names={JSON.stringify(regionLabels)} class="wrap mr-auto ml-0 max-w-[calc(60rem+2*var(--gutter))] 2xl:mx-auto 2xl:grid 2xl:max-w-(--page) 2xl:grid-cols-[minmax(0,1fr)_20rem] 2xl:gap-x-12 2xl:*:col-start-1 min-[90rem]:mx-0 min-[90rem]:max-w-none min-[90rem]:min-w-0 min-[90rem]:flex-1 min-[90rem]:px-0">
    {
      hidden && (
        <p class="mt-8 rounded-lg bg-warn px-4 py-3 font-semibold text-warn-ink" role="note">
          We have not been able to check this listing for over {HIDDEN_DAYS} days, so it is hidden from the finder.
          Treat every fact below as out of date until the funder’s page confirms it.
        </p>
      )
    }
    <KeyFacts p={p} byPartner={byPartner} />
    <section
      class:list={[
        cardClasses,
        'group/apply mt-6 px-5 pt-5 pb-[1.1rem] 2xl:top-6 2xl:col-start-2! 2xl:row-[1/span_12] 2xl:mt-12 2xl:self-start',
        // Every group's part together is too tall to ride along; one part is not.
        groups.length ? '2xl:data-narrowed:sticky' : '2xl:sticky',
      ]}
      aria-labelledby={groups.length ? undefined : 'apply-title'}
      aria-label={groups.length ? 'How to apply' : undefined}
      data-apply
    >
      {
        groups.length > 0 && (
          <label class="-mt-1 mb-4 flex items-center gap-x-3 border-b border-rule pb-3 text-md">
            <span class="flex-none text-ink-2">Where</span>
            {/* The flag and chevron sit inside the box, drawn here, each as far from its edge as the text. */}
            <span class="relative flex min-w-0">
              <span class="peer pointer-events-none absolute top-1/2 left-3 flex -translate-y-1/2 text-lg empty:hidden [&>span]:mr-0" data-where-flag></span>
              <select class="min-h-9 min-w-0 cursor-pointer appearance-none truncate rounded-md border border-control-edge bg-surface pr-9 pl-10 font-semibold peer-empty:pl-3" data-where-select>
                <option value="">Any country</option>
                {switchCountries.map((c) => <option value={c.code}>{c.name}</option>)}
              </select>
              <ChevronDown className="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-ink-2" aria-hidden="true" />
            </span>
          </label>
        )
      }
      {
        groups.length > 0 ? (
          groups.map((g, i) => (
            <ApplyPart listing={g.listing} openChildren={openChildren} childCount={children.length} titleId={`apply-title-${i}`} group={{ codes: g.codes?.join(' ') ?? '*', label: groupLabel(g.codes) }} />
          ))
        ) : (
          <ApplyPart listing={listing} openChildren={openChildren} childCount={children.length} />
        )
      }
      {/* A place the programme doesn't take: no call it can't apply to, just where to go instead. */}
      <template data-where-tpl="none">
        <div>
          <Badge variant="status" state="closed">Not in your area</Badge>
          <h2 class="mt-2 text-3xl [text-wrap:pretty] 2xl:text-2xl">Not open to projects in <span data-where-name></span></h2>
          <p class="mt-2 text-ink-2">It takes projects in {geographyFull(p.geography)}.</p>
          <div class="mt-4"><Button href="/" variant="outline" width="phone" className="2xl:w-full" data-back><span>Back to funding in <span data-where-name></span></span></Button></div>
        </div>
      </template>
    </section>

    {
      childListings.length > 0 && (
        <section class="@container/listings" aria-labelledby="partners-title">
          <SectionHeading kind="partners" id="partners-title">Partner programmes</SectionHeading>
          <p class={sectionCheck}>You apply to one of these, each with its own calls and deadlines.</p>
          <ol class={listingsList}>
            {partnersShown.map((l) => <Listing listing={l} underParent />)}
          </ol>
          {partnersLater.length > 0 && (
            <details class="group/later mt-3">
              <summary class="flex min-h-11 cursor-pointer list-none items-center gap-[0.6rem] border-b-2 border-ink py-2 text-lg font-bold before:size-2 before:flex-none before:border-r-2 before:border-b-2 before:border-current before:content-[''] before:[transform:rotate(-45deg)] group-open/later:before:[transform:translateY(-20%)_rotate(45deg)] [&::-webkit-details-marker]:hidden">
                <span>Not open now</span>
                <Badge className="ml-auto">{partnersLater.length}</Badge>
              </summary>
              <ol class={listingsList}>
                {partnersLater.map((l) => <Listing listing={l} underParent />)}
              </ol>
            </details>
          )}
        </section>
      )
    }

    <section aria-label="The facts, in the funder’s words">
      {children.length > 0 && <p class={sectionCheck}>These cover {p.name} as a whole. Each partner programme above sets its own amounts and deadlines.</p>}
      {/* Grouped by what a reader is deciding: is the money worth it, can we apply, and what applying takes. */}
      <FactGroup id="facts-money" kind="money" title="The money">
        <Fact id={factIds.amount} label="Per project" value={amount} evidence={p.evidence.amount} missing={byPartner} figures>
          {p.amount?.note && <p class={factHelp}><Figures text={sentence(p.amount.note)} /></p>}
        </Fact>
        {
          p.pool && (
            <Fact id={factIds.pool} label="Total budget" value={poolValue} evidence={p.evidence.pool} figures>
              <p class={factHelp}><Figures text={`Shared by all the grants${p.pool.note ? `. ${sentence(p.pool.note)}` : ', not one project’s share.'}`} /></p>
            </Fact>
          )
        }
        <Fact id={factIds.co_finance_required} label="Co-funding required" value={yesNo(p.co_finance_required)} evidence={p.evidence.co_finance_required} missing={byPartner} figures />
      </FactGroup>

      <FactGroup id="facts-who" kind="who" title="Who can apply">
        <Fact id={factIds.geography} label="Where" value={geographyFull(p.geography)} evidence={p.evidence.geography}>
          {p.geography?.scope === 'countries' && <span slot="value">{p.geography.label && `${p.geography.label}: `}<Countries codes={p.geography.countries} /></span>}
          <template data-where-tpl="covered"><p class="mt-1 text-md font-semibold text-ok-ink">✓ Includes <span data-where-name></span><span data-where-via></span></p></template>
          <template data-where-tpl="uncovered"><p class="mt-1 text-md font-semibold text-warn-ink">✕ Doesn’t include <span data-where-name></span></p></template>
          {more.places.length > 0 && (
            <p class={factHelp}>
              More grants in{' '}
              {more.places.map((pg, i) => (
                <>{i > 0 && (i === more.places.length - 1 ? ' and ' : ', ')}<a href={pg.path}>{pg.name}</a></>
              ))}
              .
            </p>
          )}
        </Fact>
        <Fact
          id={factIds.applicant_types}
          label="Organisations"
          value={p.applicant_types ? joinAnd(p.applicant_types.map((a) => applicantLabels[a])) : null}
          evidence={p.evidence.applicant_types}
          missing={byPartner}
        />
        {
          p.consortium_required !== undefined && (
            <Fact id={factIds.consortium_required} label="Consortium required" value={yesNo(p.consortium_required)} evidence={p.evidence.consortium_required} />
          )
        }
        <Fact id={factIds.approaches} label="Restoration approach" value={joinAnd(p.approaches.map((a) => approachLabels[a]))} missing="">
          <p class={factHelp}>Our classification, from the funder’s description of what it supports.</p>
          {more.types.length > 0 && (
            <p class={factHelp}>
              More grants for{' '}
              {more.types.map((pg, i) => (
                <>{i > 0 && (i === more.types.length - 1 ? ' and ' : ', ')}<a href={pg.path}>{pg.name.toLowerCase()}</a></>
              ))}
              .
            </p>
          )}
        </Fact>
      </FactGroup>

      <FactGroup id="facts-apply" kind="apply" title="Applying">
        <Fact id={factIds.access} label="How to apply" value={accessLabels[p.access]} evidence={p.evidence.access} missing="Not stated">
          {p.access === 'direct' && <p class={factHelp}>{accessHelp[p.access]}</p>}
        </Fact>
        {
          p.access === 'direct' && (
            <Fact
              id="effort"
              label="Work to apply"
              value={effortText(p.effort)}
              evidence={[...(p.evidence.effort ?? []), ...(p.evidence.odds ? [p.evidence.odds] : [])]}
              missing="Steps not stated"
            >
              <p class="mt-1 text-sm text-ink-2">
                Chance of funding: {oddsText ?? 'not published'} ·{' '}
                <a class="font-semibold text-ink underline underline-offset-2" href="#worth">Is it worth your time?</a>
              </p>
            </Fact>
          )
        }
        <Fact
          id={factIds.window}
          label="Rounds"
          value={p.window === 'rolling' ? 'Rolling: apply any time' : p.window === 'fixed' ? 'Fixed rounds with deadlines' : null}
          evidence={p.evidence.window}
          missing={byPartner}
        />
        {
          p.administered_by && (
            <Fact id={factIds.administered_by} label="Run by" value={p.administered_by.name} evidence={p.evidence.administered_by} />
          )
        }
      </FactGroup>
    </section>

    {
      p.access === 'direct' && (
        <section id="worth" class:list={[cardClasses, 'mt-8 px-5 pt-4 pb-5']} aria-labelledby="worth-title">
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 id="worth-title" class="flex items-center gap-2 text-2xl">
              <Calculator className="size-5 flex-none text-ink-2" aria-hidden="true" />
              Is it worth your time?
            </h2>
            <a class="text-sm text-ink-2 underline underline-offset-2" href="/worth-applying/">How to read it</a>
          </div>
          <WorthCheck amount={worth.amount} currency={worth.currency} steps={worth.steps} odds={worth.odds} />
        </section>
      )
    }

    {
      p.calls.length > 0 && (
        <section aria-labelledby="calls-title">
          <SectionHeading kind="calls" id="calls-title">
            {/* The where-view script rewrites only this span. */}
            <span data-calls-title>{p.calls.length === 1 ? 'The call' : `Calls (${p.calls.length})`}</span>
          </SectionHeading>
          {callsOrdered.map((c) => (
            // Each call folds in the same card; the one that sets the page's status starts open.
            <details id={callId(c)} class:list={[cardClasses, 'group/call px-4 pt-3.5 pb-1 md:px-[1.1rem] [&+&]:mt-3']}
              open={c === call || p.calls.length === 1}
              data-call-countries={c.countries?.join(' ') ?? ''} data-call-label={c.label}
            >
              <summary class="grid cursor-pointer list-none grid-cols-[minmax(0,1fr)_auto] items-start gap-x-3 gap-y-1 pb-3 after:col-start-2 after:row-start-1 after:mt-2 after:mr-[0.2rem] after:size-[0.55rem] after:border-r-2 after:border-b-2 after:border-ink-2 after:content-[''] after:[transform:rotate(45deg)_translateY(-0.15rem)] group-open/call:after:[transform:rotate(-135deg)_translateY(-0.1rem)] [&::-webkit-details-marker]:hidden">
                {/* The call names are the funder's own long titles: body type, not headings. */}
                <span class="flex flex-col items-start gap-1.5">
                  <span class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    <Badge variant="status" state={rollingCall(c) ? 'rolling' : c.status === 'open' ? 'open' : c.status === 'upcoming' ? 'upcoming' : c.status === 'closed' ? 'closed' : 'none'}>
                      {rollingCall(c) ? 'Rolling' : callStatusLabel[c.status]}
                    </Badge>
                    {/* Whose call it is, at a glance; the names are under Where. */}
                    {c.countries && <span class="flex gap-1 text-lg">{c.countries.map((code) => <Flag code={code} />)}</span>}
                  </span>
                  <h3 class="font-sans text-lg leading-[1.35] font-semibold">{c.label}</h3>
                </span>
                {/* Only while folded: an open call shows its dates in full below. */}
                {callWhen(c) && <span class="col-start-1 text-md text-ink-2 group-open/call:hidden">{callWhen(c)}</span>}
              </summary>
              <a class="mb-1 inline-block text-md pointer-coarse:-mt-2.5 pointer-coarse:py-2.5" href={c.url}>Call page</a>
              <dl class="m-0">
                <Fact id={callFactId(c, 'status')} label="Status" value={callStatusText(c)} evidence={c.evidence.status} />
                {c.countries && (
                  <Fact id={callFactId(c, 'countries')} label="Where" value={joinAnd(c.countries.map(countryName))} evidence={c.evidence.countries}>
                    <Countries slot="value" codes={c.countries} />
                  </Fact>
                )}
                {(c.opens || c.expected || c.evidence.opens) && (
                  <Fact
                    id={callFactId(c, 'opens')}
                    label="Opens"
                    value={c.opens ? longDate(c.opens) : c.expected ? `Expected ${c.expected}` : null}
                    evidence={c.evidence.opens ?? (c.expected ? c.evidence.status : undefined)}
                   
                  />
                )}
                {c.recurring && !c.deadline ? (
                  <Fact id={callFactId(c, 'recurring')} label="Dates each year" value={c.recurring} evidence={c.evidence.recurring} />
                ) : (
                  <Fact
                    id={callFactId(c, 'deadline')}
                    label="Deadline"
                    value={c.deadline ? deadlineText(c.deadline) : null}
                    evidence={c.evidence.deadline}
                   
                    missing={
                      p.window === 'rolling'
                        ? 'No deadline: apply any time'
                        : /window|deadline|each year|until/i.test(c.label)
                          ? 'No dated deadline: the dates in the call name repeat each year'
                          : 'Not found on the call page'
                    }
                  />
                )}
                {c.recurring && c.deadline && (
                  <Fact id={callFactId(c, 'recurring')} label="Dates each year" value={c.recurring} evidence={c.evidence.recurring} />
                )}
              </dl>
              {/* A condition on the call, in our words. */}
              {c.note && <p class="mt-0 mb-[0.85rem] text-md text-ink-2">{sentence(c.note)}</p>}
            </details>
          ))}
          {/* Narrowed to a place, the calls for other countries fold away below its own. */}
          <template data-where-tpl="other-calls">
            <details class="group/other mt-3">
              <summary class="flex min-h-11 cursor-pointer list-none items-center gap-[0.6rem] border-b-2 border-ink py-2 text-lg font-bold before:size-2 before:flex-none before:border-r-2 before:border-b-2 before:border-current before:content-[''] before:[transform:rotate(-45deg)] group-open/other:before:[transform:translateY(-20%)_rotate(45deg)] [&::-webkit-details-marker]:hidden">
                <span>Calls for other countries</span>
                <Badge className="ml-auto" data-calls-other-count />
              </summary>
              <div class="mt-3" data-calls-other-list></div>
            </details>
          </template>
        </section>
      )
    }

    {
      !primary.quiet && (
        <p class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-[0.6rem] border-t border-rule pt-5 2xl:hidden" data-cta>
          <span class="font-bold" data-cta-label>{call && primary.href === call.url ? `Ready to apply to ${call.label}?` : 'Ready to apply?'}</span>
          <Button href={primary.href} width="phone" data-cta-button>{primary.text}</Button>
        </p>
      )
    }

    <section aria-labelledby="reporting-title">
      <SectionHeading kind="reporting" id="reporting-title">What the funder asks grantees to report</SectionHeading>
      <dl class="m-0 border-b border-rule">
        <Fact id={factIds.reporting} label="Reporting" value={p.reporting} evidence={p.evidence.reporting} />
      </dl>
      {
        p.reporting && (
          <p class="mt-4 text-sm text-ink-2">
            From the builders of this site: <a href={RS_REPORTING_URL}>Restoration Scope</a> makes software for
            reporting to funders like this one.
          </p>
        )
      }
    </section>

    {
      parent && (
        <section aria-labelledby="related-title">
          <SectionHeading kind="related" id="related-title">Part of a larger programme</SectionHeading>
          <p>
            <a href={`/p/${parent.id}/`}>{parent.name}</a>, from {parent.funder.name}
          </p>
        </section>
      )
    }

    {/* A footnote, not a section: it matters to the few who spot a mistake. */}
    <section class="mt-16 max-w-[62ch] border-t border-rule pt-5 text-md text-ink-2" aria-labelledby="fix-title">
      <h2 id="fix-title" class="text-md font-bold text-ink">Something wrong?</h2>
      <p class="mt-1">
        Every fact above links to the page we read it from. If a deadline, amount or rule has changed, <a href={reportProblemUrl(p.name, p.id)}>report a problem</a>{' '}
        and we will check it against the funder’s page.
        Are you this funder? <a href={funderCorrectionUrl(p.name, p.id)}>Correct this listing</a>.
      </p>
      <p class="mt-2 text-sm">Both open an email to {CONTACT_EMAIL} with this listing filled in. Listings can’t be bought.</p>
    </section>
  </div>
  </div>
</Base>

<script>
  import { initWhereView } from '../../lib/where-view'
  import { initPageContents } from '../../lib/page-contents'
  initWhereView()
  initPageContents()
</script>
