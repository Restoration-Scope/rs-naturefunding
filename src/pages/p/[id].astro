---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import CheckedTag from '../../components/CheckedTag.astro'
import Fact from '../../components/Fact.astro'
import Listing from '../../components/Listing.astro'
import OrgMark from '../../components/OrgMark.astro'
import Route from '../../components/Route.astro'
import { callFactId, callId, factIds, grantJsonLd } from '../../lib/agent'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { cardClasses } from '@/components/ui/card'
import { HIDDEN_DAYS, buildDate, daysBetween, listingFor, notRechecked, notRecheckedPage, programmeById, programmes, sortListings } from '../../lib/data'
import type { Programme } from '../../data/schema'
import { amountText, geographyFull, joinAnd, longDate, pageLabel } from '../../lib/format'
import {
  accessHelp,
  accessLabels,
  applicantLabels,
  approachLabels,
  stateLabels,
} from '../../lib/labels'
import { ArrowLeft } from 'lucide-react'
import { CONTACT_EMAIL, RS_REPORTING_URL, absolute, funderCorrectionUrl, reportProblemUrl } from '../../lib/site'

export const getStaticPaths = (() => programmes.map((p) => ({ params: { id: p.id }, props: { p } }))) satisfies GetStaticPaths

const { p } = Astro.props as { p: Programme }
const listing = listingFor(p)
const hidden = listing.ageDays > HIDDEN_DAYS
const { state, call } = listing
const parent = p.parent ? programmeById.get(p.parent) : undefined
const children = programmes.filter((c) => c.parent === p.id)
const childListings = children.map((c) => listingFor(c)).sort(sortListings)
// "Forest Action Facility" from "Forest Action Facility (established by IUCN and KfW)": show only what the name doesn't say.
const funderQualifier = p.funder.name.startsWith(p.name)
  ? p.funder.name.slice(p.name.length).trim().replace(/^\((.*)\)$/, '$1').replace(/^./, (ch) => ch.toUpperCase())
  : null
// An umbrella's own page often leaves these to its partner programmes.
const byPartner = childListings.length > 0 ? 'Set by each partner programme' : undefined
const openChildren = childListings.filter((l) => l.state === 'open' || l.state === 'rolling')
// Partners with no call open now fold away below the live ones, as on the finder.
const partnersNow = childListings.filter((l) => l.state !== 'none' && l.state !== 'closed')
const partnersLater = partnersNow.length > 0 ? childListings.filter((l) => !partnersNow.includes(l)) : []
const partnersShown = partnersNow.length > 0 ? partnersNow : childListings
const noCallRoute = p.access === 'intermediary' || p.access === 'invitation_only'
const amount = amountText(p.amount)
const yesNo = (b: boolean | null) => (b === null ? null : b ? 'Yes' : 'No')
// The tag in the apply box dates the fact the box states: the call, or how to apply.
const applyEvidence =
  (call && (call.evidence.deadline ?? call.evidence.recurring ?? call.evidence.status)) ?? p.evidence.access ?? null
/** "America/Guayaquil" → "Ecuador Time", as the browser names it; the raw zone when it has no name. */
const zoneName = (tz: string, date: string) => {
  try {
    const name = new Intl.DateTimeFormat('en-GB', { timeZone: tz, timeZoneName: 'long' })
      .formatToParts(new Date(`${date}T12:00:00Z`))
      .find((x) => x.type === 'timeZoneName')?.value
    return name ?? tz
  } catch {
    return tz
  }
}
const deadlineText = (d: NonNullable<Programme['calls'][number]['deadline']>) =>
  `${longDate(d.date)}${d.time ? `, ${d.time}${d.timezone ? ` ${zoneName(d.timezone, d.date)}` : ''}` : ''}`
const primary: { href: string; text: string; quiet?: boolean } =
  call && (state === 'open' || state === 'rolling' || state === 'upcoming')
    ? { href: call.url, text: 'Go to the funder’s call page' }
    : call?.recurring && state === 'none'
      ? { href: call.url, text: 'Check the call page' }
      : openChildren.length === 1
      ? { href: `/p/${openChildren[0]!.p.id}/`, text: 'See the open partner programme' }
      : openChildren.length > 1
        ? { href: '#partners-title', text: `See the ${openChildren.length} open partner programmes` }
        : p.access === 'intermediary' && children.length > 0
          ? { href: '#partners-title', text: `See the ${children.length} partner programmes` }
          : p.access === 'intermediary'
            ? { href: p.evidence.access?.source_url ?? p.url, text: 'Find a partner on the funder’s site' }
            : { href: p.url, text: 'Read the funder’s page', quiet: true }
/** The one date a folded call shows next to its name. */
const callWhen = (c: Programme['calls'][number]) =>
  c.status === 'upcoming'
    ? c.opens
      ? `Opens ${longDate(c.opens)}`
      : c.expected
        ? `Expected ${c.expected}`
        : 'Opening date not announced yet'
    : c.deadline
      ? `${c.status === 'closed' || c.deadline.date < buildDate ? 'Closed' : 'Closes'} ${longDate(c.deadline.date)}`
      : c.status === 'open'
        ? 'No deadline stated'
        : null
const bandMark = 'mr-1.5 -mt-0.5 box-content rounded-[5px] bg-white p-0.5'
const callStatusLabel: Record<string, string> = {
  open: 'Open',
  upcoming: 'Upcoming',
  closed: 'Closed',
  suspended: 'Suspended',
  unknown: 'Not clear from the page',
}
// The call that sets the page's status comes first and open; the others fold.
// The rest follow by deadline, soonest first; undated calls last.
const byCallDeadline = (a: Programme['calls'][number], b: Programme['calls'][number]) =>
  (a.deadline?.date ?? '9999').localeCompare(b.deadline?.date ?? '9999')
const callsOrdered = call ? [call, ...p.calls.filter((c) => c !== call).sort(byCallDeadline)] : [...p.calls].sort(byCallDeadline)
// A rolling programme's open call reads as the finder says it: Rolling.
const rollingCall = (c: Programme['calls'][number]) => p.window === 'rolling' && c.status === 'open'
const callStatusText = (c: Programme['calls'][number]) =>
  rollingCall(c)
    ? 'Rolling: apply any time'
    : c.status === 'unknown' && c.recurring
      ? 'Windows each year; the page doesn’t say if one is open now'
      : callStatusLabel[c.status]

const description = `${p.name} from ${p.funder.name}: ${
  state === 'open' && call?.deadline
    ? `open, deadline ${call.deadline.text}.`
    : state === 'rolling'
      ? 'open, apply any time.'
      : noCallRoute
        ? `${accessLabels[p.access].toLowerCase()}.`
        : `${stateLabels[state].toLowerCase()}.`
} ${amount ? `${amount}. ` : ''}Each fact links to the funder’s own page.`

const grantLd = grantJsonLd(listing)
const sectionTitle = 'mt-12 mb-3 text-4xl'
/** A line under a section title: where its quotes come from, or what it covers. */
const sectionCheck = 'mb-3 text-sm text-ink-2'
const factHelp = 'mt-1 text-md text-ink'
const listingsList = 'm-0 list-none border-t border-rule p-0'

const jsonLd = [
  ...grantLd,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Find funding', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: p.name, item: absolute(`/p/${p.id}/`) },
    ],
  },
]
---

<Base
  title={`${p.name}, ${p.funder.name}`}
  description={description}
  path={`/p/${p.id}/`}
  jsonLd={jsonLd}
  noindex={hidden}
>
  <div slot="band" class="wrap pt-4 pb-6 md:pt-5 md:pb-8 [&_a]:text-shell-ink">
    <a class="group/back mb-4 inline-flex items-center gap-1.5 text-md text-shell-ink-2! pointer-coarse:-my-2.5 pointer-coarse:mb-1.5 pointer-coarse:py-2.5" href="/"><ArrowLeft className="size-4 shrink-0 transition-transform group-hover/back:-translate-x-0.5" aria-hidden="true" />All funding</a>
    <h1 class="max-w-[30ch] text-[clamp(1.5rem,1.1rem+1.8vw,2.5rem)] leading-[1.12] tracking-[-0.01em]">{p.name}</h1>
    {/* Phones: two lines at most, so the apply box starts higher; every name stays in the Run by fact. */}
    <p class="mt-[0.6rem] text-lg text-shell-ink-2 max-md:line-clamp-2" title={p.administered_by ? `${p.funder.name}, run by ${p.administered_by.name}` : undefined}>
      {/* Marks sit on a white tile: most favicons are drawn for a light page, not the green band. */}
      {
        funderQualifier !== null ? (
          <><OrgMark org={p.funder} size={24} class={bandMark} /><a href={p.funder.url}>{funderQualifier || 'The funder’s website'}</a></>
        ) : (
          <>From <OrgMark org={p.funder} size={24} class={bandMark} /><a href={p.funder.url}>{p.funder.name}</a></>
        )
      }
      {p.administered_by && <span>, run by <OrgMark org={p.administered_by} size={20} class={bandMark} /><a href={p.administered_by.url}>{p.administered_by.name}</a></span>}
    </p>
    {p.kind === 'partnership' && <p class="mt-4 font-bold">Paid partnership, not a grant: the funder pays for work under a contract.</p>}
    <p class:list={['max-w-[62ch] text-lg max-md:text-base max-md:leading-[1.45]', p.kind === 'partnership' ? 'mt-[0.35rem]' : 'mt-4 max-md:mt-3']}>{p.summary}</p>
    <p class="mt-2 text-sm text-shell-ink-2">Summary in our words. Each fact below shows the funder’s own words and links to its page.</p>
  </div>

  {/* Wide screens: the apply box rides along in a right rail while the facts scroll. */}
  <div class="wrap mr-auto ml-0 max-w-[calc(60rem+2*var(--gutter))] 2xl:mx-auto 2xl:grid 2xl:max-w-(--page) 2xl:grid-cols-[minmax(0,1fr)_20rem] 2xl:gap-x-12 2xl:*:col-start-1">
    {
      hidden && (
        <p class="mt-8 rounded-lg bg-warn px-4 py-3 font-semibold text-warn-ink" role="note">
          We have not been able to check this listing for over {HIDDEN_DAYS} days, so it is hidden from the finder.
          Treat every fact below as out of date until the funder’s page confirms it.
        </p>
      )
    }
    <section
      class:list={[cardClasses, 'mt-6 px-5 pt-5 pb-[1.1rem] 2xl:sticky 2xl:top-6 2xl:col-start-2! 2xl:row-[1/span_12] 2xl:mt-12 2xl:self-start']}
      aria-labelledby="apply-title"
    >
      <div class="flex flex-wrap items-center gap-x-[0.85rem] gap-y-2">
        {/* Invitation-only funders and umbrellas never have a call of their own: the route is their status. */}
        <span class="flex flex-wrap items-center gap-2">
          {!(state === 'none' && noCallRoute) && <Badge variant="status" state={state}>{stateLabels[state]}</Badge>}
          {noCallRoute && <Route access={p.access} />}
        </span>
        <h2 id="apply-title" class="text-3xl [text-wrap:pretty] 2xl:text-2xl">
          {state === 'open' && call?.deadline && <>Apply by <span class="whitespace-nowrap">{longDate(call.deadline.date)}</span></>}
          {state === 'open' && call && !call.deadline && (call.recurring ? <>Open, with deadlines each year</> : <>Open, no dated deadline</>)}
          {state === 'rolling' && <>Apply any time</>}
          {state === 'upcoming' &&
            (call?.opens ? (
              <>Opens <span class="whitespace-nowrap">{longDate(call.opens)}</span></>
            ) : call?.expected ? (
              <>Expected to open <span class="whitespace-nowrap">{call.expected}</span></>
            ) : (
              <>Not open yet</>
            ))}
          {state === 'closed' && <>No call open right now</>}
          {state === 'none' && p.access === 'invitation_only' && <>This funder does not take applications</>}
          {state === 'none' && p.access === 'intermediary' && openChildren.length === 0 && <>Apply through a partner, not the funder</>}
          {state === 'none' && p.access === 'intermediary' && openChildren.length > 0 && (
            <>{openChildren.length === 1 ? 'One partner programme is open now' : `${openChildren.length} partner programmes are open now`}</>
          )}
          {state === 'none' && !noCallRoute && (call?.recurring ? <>Windows each year</> : <>No call listed</>)}
        </h2>
      </div>
      {
        state === 'open' && call?.deadline && (
          <dl class="mt-3 mb-0 grid gap-[0.35rem] text-md *:grid *:grid-cols-[max-content_minmax(0,1fr)] *:gap-3 [&_dd]:m-0 [&_dt]:text-ink-2">
            <div><dt>Days left</dt><dd class="font-bold tabular-nums">{daysBetween(buildDate, call.deadline.date)}</dd></div>
            <div><dt>Call</dt><dd>{call.label}</dd></div>
          </dl>
        )
      }
      <p class="mt-2 text-ink-2 empty:hidden">
        {state === 'open' && call && !call.deadline && !call.recurring && <>{call.label}. The funder’s page gives no dated deadline, so check that the window is still open before you apply.</>}
        {state === 'open' && call?.recurring && !call.deadline && <>{call.recurring}, each year. The page gives no year, so check which date comes next before you apply.</>}
        {state === 'rolling' && call && !/rolling/i.test(call.label) && <>{call.label}</>}
        {state === 'upcoming' && (call?.evidence.opens ?? (call?.expected && call.evidence.status)) && (
          <>The funder says: “{(call.evidence.opens ?? call.evidence.status)!.quote}”{' '}</>
        )}
        {state === 'none' && call?.recurring && <>{call.recurring}. The funder’s page doesn’t say whether one is open now.</>}
        {state === 'upcoming' && call?.deadline && <>Closes {longDate(call.deadline.date)}.</>}
        {call?.note && (state === 'open' || state === 'upcoming') && <> {call.note}.</>}
        {state === 'closed' && call?.deadline && <>The last call we saw closed on {longDate(call.deadline.date)}.</>}
        {noCallRoute && accessHelp[p.access]}
        {/* The list beside this card has the open call's date; here, just where to look. */}
        {
          openChildren.length === 1 && (
            <>
              {' '}The open one is <strong>{openChildren[0]!.p.name}</strong>
              {openChildren[0]!.call?.deadline ? <>, apply by <span class="whitespace-nowrap">{longDate(openChildren[0]!.call.deadline.date)}</span>.</> : <>.</>}
            </>
          )
        }
        {openChildren.length > 1 && <> {openChildren.length} partner programmes are open now. They come first in the list below.</>}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
        <Button href={primary.href} variant={primary.quiet ? 'outline' : 'default'} width="phone" className="whitespace-normal text-center 2xl:w-full">{primary.text}</Button>
        {
          applyEvidence ? (
            <CheckedTag checked={applyEvidence.checked_at} source={{ url: applyEvidence.source_url, label: pageLabel(applyEvidence.source_url) }} reason={notRecheckedPage(applyEvidence.source_url)} />
          ) : (
            <CheckedTag checked={p.checked_at} reason={notRechecked(p.id)} />
          )
        }
      </div>
    </section>

    {
      childListings.length > 0 && (
        <section class="@container/listings" aria-labelledby="partners-title">
          <h2 id="partners-title" class={sectionTitle}>Partner programmes</h2>
          <p class={sectionCheck}>You apply to one of these, each with its own calls and deadlines.</p>
          <ol class={listingsList}>
            {partnersShown.map((l) => <Listing listing={l} underParent />)}
          </ol>
          {partnersLater.length > 0 && (
            <details class="group/later mt-3">
              <summary class="flex min-h-11 cursor-pointer list-none items-center gap-[0.6rem] border-b-2 border-ink py-2 text-lg font-bold before:size-2 before:flex-none before:border-r-2 before:border-b-2 before:border-current before:content-[''] before:[transform:rotate(-45deg)] group-open/later:before:[transform:translateY(-20%)_rotate(45deg)] [&::-webkit-details-marker]:hidden">
                <span>Not open now</span>
                <Badge className="ml-auto">{partnersLater.length}</Badge>
              </summary>
              <ol class={listingsList}>
                {partnersLater.map((l) => <Listing listing={l} underParent />)}
              </ol>
            </details>
          )}
        </section>
      )
    }

    <section aria-labelledby="facts-title">
      <h2 id="facts-title" class={sectionTitle}>The facts, in the funder’s words</h2>
      {children.length > 0 && <p class={sectionCheck}>These cover {p.name} as a whole. Each partner programme above sets its own amounts and deadlines.</p>}
      <dl class="m-0 border-b border-rule">
        <Fact id={factIds.access} label="How to apply" value={accessLabels[p.access]} evidence={p.evidence.access} missing="Not stated">
          {p.access === 'direct' && <p class={factHelp}>{accessHelp[p.access]}</p>}
        </Fact>
        <Fact id={factIds.amount} label="Amount" value={amount} evidence={p.evidence.amount} missing={byPartner}>
          {p.amount?.note && <p class={factHelp}>{p.amount.note}.</p>}
        </Fact>
        <Fact id={factIds.geography} label="Where" value={geographyFull(p.geography)} evidence={p.evidence.geography} />
        <Fact
          id={factIds.applicant_types}
          label="Who can apply"
          value={p.applicant_types ? joinAnd(p.applicant_types.map((a) => applicantLabels[a])) : null}
          evidence={p.evidence.applicant_types}
         
          missing={byPartner}
        />
        <Fact
          id={factIds.window}
          label="Rounds"
          value={p.window === 'rolling' ? 'Rolling: apply any time' : p.window === 'fixed' ? 'Fixed rounds with deadlines' : null}
          evidence={p.evidence.window}
         
          missing={byPartner}
        />
        <Fact id={factIds.co_finance_required} label="Co-funding required" value={yesNo(p.co_finance_required)} evidence={p.evidence.co_finance_required} missing={byPartner} />
        {
          p.consortium_required !== undefined && (
            <Fact id={factIds.consortium_required} label="Consortium required" value={yesNo(p.consortium_required)} evidence={p.evidence.consortium_required} />
          )
        }
        {
          p.administered_by && (
            <Fact id={factIds.administered_by} label="Run by" value={p.administered_by.name} evidence={p.evidence.administered_by} />
          )
        }
        <Fact id={factIds.approaches} label="Restoration approach" value={joinAnd(p.approaches.map((a) => approachLabels[a]))} missing="">
          <p class={factHelp}>Our classification, from the funder’s description of what it supports.</p>
        </Fact>
      </dl>
    </section>

    {
      p.calls.length > 0 && (
        <section aria-labelledby="calls-title">
          <h2 id="calls-title" class={sectionTitle}>
            {p.calls.length === 1 ? 'The call' : `Calls (${p.calls.length})`}
          </h2>
          {callsOrdered.map((c) => (
            // Each call folds in the same card; the one that sets the page's status starts open.
            <details id={callId(c)} class:list={[cardClasses, 'group/call px-4 pt-3.5 pb-1 md:px-[1.1rem] [&+&]:mt-3']}
              open={c === call || p.calls.length === 1}
            >
              <summary class="grid cursor-pointer list-none grid-cols-[minmax(0,1fr)_auto] items-start gap-x-3 gap-y-1 pb-3 after:col-start-2 after:row-start-1 after:mt-2 after:mr-[0.2rem] after:size-[0.55rem] after:border-r-2 after:border-b-2 after:border-ink-2 after:content-[''] after:[transform:rotate(45deg)_translateY(-0.15rem)] group-open/call:after:[transform:rotate(-135deg)_translateY(-0.1rem)] [&::-webkit-details-marker]:hidden">
                {/* The call names are the funder's own long titles: body type, not headings. */}
                <span class="flex flex-col items-start gap-1.5">
                  <Badge variant="status" state={rollingCall(c) ? 'rolling' : c.status === 'open' ? 'open' : c.status === 'upcoming' ? 'upcoming' : c.status === 'closed' ? 'closed' : 'none'}>
                    {rollingCall(c) ? 'Rolling' : callStatusLabel[c.status]}
                  </Badge>
                  <h3 class="font-sans text-lg leading-[1.35] font-semibold">{c.label}</h3>
                </span>
                {/* Only while folded: an open call shows its dates in full below. */}
                {callWhen(c) && <span class="col-start-1 text-md text-ink-2 group-open/call:hidden">{callWhen(c)}</span>}
              </summary>
              <a class="mb-1 inline-block text-md pointer-coarse:-mt-2.5 pointer-coarse:py-2.5" href={c.url}>Call page</a>
              <dl class="m-0">
                <Fact id={callFactId(c, 'status')} label="Status" value={callStatusText(c)} evidence={c.evidence.status} />
                {(c.opens || c.expected || c.evidence.opens) && (
                  <Fact
                    id={callFactId(c, 'opens')}
                    label="Opens"
                    value={c.opens ? longDate(c.opens) : c.expected ? `Expected ${c.expected}` : null}
                    evidence={c.evidence.opens ?? (c.expected ? c.evidence.status : undefined)}
                   
                  />
                )}
                {c.recurring && !c.deadline ? (
                  <Fact id={callFactId(c, 'recurring')} label="Dates each year" value={c.recurring} evidence={c.evidence.recurring} />
                ) : (
                  <Fact
                    id={callFactId(c, 'deadline')}
                    label="Deadline"
                    value={c.deadline ? deadlineText(c.deadline) : null}
                    evidence={c.evidence.deadline}
                   
                    missing={
                      p.window === 'rolling'
                        ? 'No deadline: apply any time'
                        : /window|deadline|each year|until/i.test(c.label)
                          ? 'No dated deadline: the dates in the call name repeat each year'
                          : 'Not found on the call page'
                    }
                  />
                )}
                {c.recurring && c.deadline && (
                  <Fact id={callFactId(c, 'recurring')} label="Dates each year" value={c.recurring} evidence={c.evidence.recurring} />
                )}
              </dl>
              {/* A condition on the call, in our words. */}
              {c.note && <p class="mt-0 mb-[0.85rem] text-md text-ink-2">{c.note}.</p>}
            </details>
          ))}
        </section>
      )
    }

    {
      !primary.quiet && (
        <p class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-[0.6rem] border-t border-rule pt-5 2xl:hidden">
          <span class="font-bold">{call && primary.href === call.url ? `Ready to apply to ${call.label}?` : 'Ready to apply?'}</span>
          <Button href={primary.href} width="phone">{primary.text}</Button>
        </p>
      )
    }

    <section aria-labelledby="reporting-title">
      <h2 id="reporting-title" class={sectionTitle}>What the funder asks grantees to report</h2>
      <dl class="m-0 border-b border-rule">
        <Fact id={factIds.reporting} label="Reporting" value={p.reporting} evidence={p.evidence.reporting} />
      </dl>
      {
        p.reporting && (
          <p class="mt-4 text-sm text-ink-2">
            From the builders of this site: <a href={RS_REPORTING_URL}>Restoration Scope</a> makes software for
            reporting to funders like this one.
          </p>
        )
      }
    </section>

    {
      parent && (
        <section aria-labelledby="related-title">
          <h2 id="related-title" class={sectionTitle}>
            Part of a larger programme
          </h2>
          <p>
            <a href={`/p/${parent.id}/`}>{parent.name}</a>, from {parent.funder.name}
          </p>
        </section>
      )
    }

    <section class="[&>p]:max-w-[62ch]" aria-labelledby="fix-title">
      <h2 id="fix-title" class={sectionTitle}>Something wrong?</h2>
      <p>
        Every fact above links to the page we read it from. If a deadline, amount or rule has
        changed, tell us and we will check it against the funder’s page.
      </p>
      <div class="mt-4 flex flex-wrap gap-3 max-md:flex-col">
        <Button href={reportProblemUrl(p.name, p.id)} variant="outline" width="phone">Report a problem</Button>
        <Button href={funderCorrectionUrl(p.name, p.id)} variant="outline" width="phone">Are you this funder? Correct this listing</Button>
      </div>
      <p class="mt-[0.6rem] text-sm text-ink-2">Both open an email to {CONTACT_EMAIL} with this listing filled in. Listings can’t be bought.</p>
    </section>
  </div>
</Base>
