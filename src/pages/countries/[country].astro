---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import Row from '../../components/FinderRow.astro'
import DigestSignup from '../../components/DigestSignup.astro'
import { Table, TableBody, TableCaption, TableHead, TableHeader, TableRow } from '@/components/ui/table'
import '../../styles/finder.css'
import { COUNTRY_PAGES, countryListings, countrySlug, type Reach } from '../../lib/countries'
import { homeItemListLd } from '../../lib/agent'
import { longDate } from '../../lib/format'
import { absolute } from '../../lib/site'
import { stats } from '../../lib/data'

export const getStaticPaths = (() =>
  COUNTRY_PAGES.map((iso2) => ({ params: { country: countrySlug(iso2) }, props: { iso2 } }))) satisfies GetStaticPaths

const { iso2 } = Astro.props as { iso2: string }
const c = countryListings(iso2)
const path = `/countries/${countrySlug(iso2)}/`
const n = c.groups
const plural = (k: number, one: string, many: string) => `${k} ${k === 1 ? one : many}`

const sections: { key: Reach; title: string; hint: string }[] = [
  { key: 'named', title: `Programmes that name ${c.name}`, hint: `The funder lists ${c.name} among the countries it funds.` },
  { key: 'region', title: `Open across ${c.region}`, hint: `The funder takes projects anywhere in ${c.region}.` },
  { key: 'global', title: 'Open worldwide', hint: 'The funder takes projects in any country.' },
]

const title = `Grants for nature restoration and conservation in ${c.name}`
const lead = `${plural(c.all.length, 'grant or funding programme takes', 'grants and funding programmes take')} nature restoration and conservation projects in ${c.name}: ${n.named.length} name ${c.name}, ${n.region.length} cover all of ${c.region} and ${n.global.length} are open worldwide. ${c.open} ${c.open === 1 ? 'is' : 'are'} open now.`
const description = `${lead} Every deadline links to the funder’s own page. Free, with no paid listings.`

const jsonLd = [
  homeItemListLd(c.all, title),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'naturefunding.org', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: c.name, item: absolute(path) },
    ],
  },
]
---

<Base title={`Grants for NGOs in ${c.name}: restoration and conservation funding`} description={description} path={path} jsonLd={jsonLd}>
  <div slot="band" class="pb-14 max-md:pb-10">
    <div class="wrap grid items-end gap-x-14 gap-y-3 pt-3 lg:grid-cols-[5fr_7fr] max-md:pt-1">
      <div>
        <nav aria-label="Breadcrumb" class="mb-3 text-sm text-shell-ink-2">
          <a class="text-shell-ink-2! underline-offset-[0.18em]" href="/">All grants</a>
          <span aria-hidden="true"> / </span>
          <span>{c.name}</span>
        </nav>
        <h1 class="text-balance text-[clamp(1.875rem,1.2rem+1.4vw,2.5rem)] leading-[1.08] tracking-[-0.01em] text-shell-ink">{title}</h1>
      </div>
      <p class="text-[0.9375rem] leading-[1.55] text-shell-ink-2">
        <span class="text-shell-ink">{lead}</span>{' '}
        For nonprofits and community groups leading projects on the ground. Every deadline, amount and eligibility rule links to the funder’s own page, with its exact words and the date we checked it.
        {stats.lastChecked && ` Last checked ${longDate(stats.lastChecked)}.`}
      </p>
    </div>
  </div>

  <div class="wrap mt-8 grid gap-10 max-md:mt-6 max-md:gap-8">
    {
      sections.map(({ key, title, hint }) =>
        n[key].length === 0 ? null : (
          <section class="results @container/tbl min-w-0" aria-labelledby={`h-${key}`}>
            <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 id={`h-${key}`} class="text-2xl">{title}</h2>
              <p class="text-sm text-muted-foreground">
                {hint} <span class="tabular-nums">{plural(n[key].length, 'programme', 'programmes')}</span>, open calls first.
              </p>
            </div>
            <div class="tbl-wrap">
              <Table className="tbl">
                <TableCaption className="sr-only">{title}</TableCaption>
                <TableHeader>
                  <TableRow>
                    <TableHead scope="col" className="h-prog">Programme and funder</TableHead>
                    <TableHead scope="col" className="h-dl">Deadline</TableHead>
                    <TableHead scope="col" className="h-amount">Amount</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {n[key].map((l) => <Row listing={l} />)}
                </TableBody>
              </Table>
            </div>
          </section>
        ),
      )
    }

    <p class="text-ink-2">
      Want to narrow these down by project type, deadline or who can apply?
      <a href={`/?where=${iso2}#results`}>Filter grants for {c.name} in the finder</a>.
    </p>

    <DigestSignup compact />
  </div>
</Base>
