---
import type { Listing } from '../lib/data'
import { buildDate, daysBetween } from '../lib/data'
import { longDate, shortDate } from '../lib/format'
import { stateLabels } from '../lib/labels'
import { Badge } from '@/components/ui/badge'

interface Props {
  listing: Listing
  /** For an umbrella: how many of its partner programmes are open now. */
  openPartners: number
}

const { listing, openPartners } = Astro.props
const { p, state, call } = listing
const deadline = call?.deadline ?? null
const daysLeft = state === 'open' && deadline ? daysBetween(buildDate, deadline.date) : null
const left = (n: number) => (n === 0 ? 'Closes today' : n === 1 ? '1 day left' : `${n} days left`)
// The deadline cell, read at a glance: one line on when to apply, then the status and days left. The funder's
// own words wait on the programme page and the date's tooltip, in every state that has them.
const yearly = call?.recurring ?? null
const quoted = (s?: string | null) => (s ? `As the funder wrote it: “${s}”` : undefined)
// Without a deadline, what the funder's page says about opening or the call's status.
const statusQuote = call ? (call.evidence.opens?.quote ?? call.evidence.status.quote) : null
const when: { text: string; muted?: boolean; title?: string } =
  state === 'open'
    ? deadline
      ? { text: shortDate(deadline.date), title: quoted(deadline.text) }
      : yearly
        ? { text: 'Yearly call', title: yearly }
        : { text: 'Date not stated', muted: true, title: quoted(statusQuote) }
    : state === 'rolling'
      ? { text: 'Any time', title: quoted(statusQuote) }
      : state === 'upcoming'
        ? {
            ...(call?.opens
              ? { text: `Opens ${shortDate(call.opens)}` }
              : call?.expected
                ? { text: `Expected ${call.expected}` }
                : deadline
                  ? { text: `Closes ${shortDate(deadline.date)}` }
                  : { text: 'Not dated yet', muted: true }),
            title: deadline ? `Closes ${longDate(deadline.date)}. ${quoted(deadline.text)}` : quoted(statusQuote),
          }
        : state === 'closed'
          ? { text: deadline ? shortDate(deadline.date) : 'Date not stated', muted: true, title: quoted(deadline?.text) }
          : p.access === 'intermediary'
            ? openPartners > 0
              ? { text: `${openPartners} partner programme${openPartners === 1 ? '' : 's'} open` }
              : { text: 'Varies by partner', muted: true }
            : yearly
              ? { text: 'Yearly call', muted: true, title: yearly }
              : { text: 'No date', muted: true }
---

<span class:list={['dl__when', when.muted && 'dl__when--muted']} title={when.title}>{when.text}</span>
<span class="dl__meta">
  <Badge variant="status" state={state}>{stateLabels[state]}</Badge>
  {
    daysLeft !== null && (
      <span class="dl__left" data-left data-soon={daysLeft <= 7 ? '' : undefined}>
        {left(daysLeft)}
      </span>
    )
  }
</span>
