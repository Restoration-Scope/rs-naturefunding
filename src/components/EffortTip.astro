---
import { effortLabels } from '../lib/effort-tip'

/**
 * The one tooltip the finder's effort bars share (src/lib/effort-tip.ts fills and places it). Hidden on touch.
 * One block per signal, split by edge-to-edge rules: a title line with the bar's colour, the signal and its level,
 * then the reason.
 */
const bar = 'inline-block h-3.5 w-1.5 rounded-[2px] flex-none'
---

<div
  data-effort-tip
  hidden
  aria-hidden="true"
  class="fixed z-50 w-max max-w-[min(18rem,calc(100vw-1rem))] overflow-hidden rounded-md bg-foreground text-xs text-balance text-background pointer-coarse:!hidden"
>
  <span class="block px-3 pt-2 pb-1 font-semibold">What it asks of you</span>
  {
    effortLabels.map((l) => (
      <span class="block px-3 py-2 border-t border-background/25" data-tip-row>
        <span class="flex items-center gap-2 font-semibold">
          <span class={bar} data-base={bar} />
          <span>
            {l} · <span data-tip-level />
          </span>
        </span>
        <span class="mt-0.5 block opacity-90" data-tip-why />
      </span>
    ))
  }
</div>
