---
import type { Evidence } from '../data/schema'
import type { SharedSource } from '../lib/data'
import { keepAmountTogether, pageLabel } from '../lib/format'
import CheckedTag from './CheckedTag.astro'

interface Props {
  label: string
  /** What we show. Null means the funder's page does not say. */
  value: string | null
  evidence?: Evidence
  /** Shown instead of "Not found on the pages we read" when the value is null. */
  missing?: string
  /** The section already names this page and date, so the quote skips its own tag. */
  shared?: SharedSource | null
}

const { label, value, evidence, missing = 'Not found on the pages we read', shared } = Astro.props
const shown = value && label === 'Amount' ? keepAmountTogether(value) : value
const ownTag = evidence && !(shared && evidence.source_url === shared.url && evidence.checked_at === shared.checked)
---

<div class="fact">
  <dt class="fact__label">{label}</dt>
  <dd class="fact__body">
    {shown ? <p class:list={['fact__value', { 'fact__value--long': shown.length > 70 }]}>{shown}</p> : <p class="fact__value fact__value--missing">{missing}</p>}
    <slot />
    {
      evidence && (
        <figure class="fact__evidence">
          <blockquote class="fact__quote" cite={evidence.source_url}>
            <p>{evidence.quote}</p>
          </blockquote>
          {ownTag && (
            <figcaption>
              <CheckedTag checked={evidence.checked_at} compact source={{ url: evidence.source_url, label: pageLabel(evidence.source_url) }} />
            </figcaption>
          )}
        </figure>
      )
    }
  </dd>
</div>

<style>
  .fact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .fact {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  .fact__label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink-2);
    padding-top: 0.15rem;
  }
  .fact__body {
    margin: 0;
    min-width: 0;
  }
  .fact__value {
    font-weight: 600;
    font-size: 1.0625rem;
  }
  /* A long summary in our words reads as text, so it doesn't outweigh the quote under it. */
  .fact__value--long {
    font-weight: 400;
    font-size: 1rem;
  }
  .fact__value--missing {
    font-weight: 400;
    color: var(--ink-2);
  }
  .fact__evidence {
    margin: 0.4rem 0 0;
  }
  /* The funder's words hang off a rule, so the facts read as one list rather than a stack of boxes. */
  .fact__quote {
    margin: 0;
    padding: 0.1rem 0 0.1rem 0.85rem;
    border-left: 3px solid var(--rule-strong);
    font-size: 0.9875rem;
    color: var(--ink);
    max-width: 65ch;
  }
  .fact__evidence figcaption {
    margin-top: 0.45rem;
  }
  .fact__quote p::before {
    content: '“';
  }
  .fact__quote p::after {
    content: '”';
  }
</style>
