---
import type { Evidence } from '../data/schema'
import { keepAmountTogether, pageLabel } from '../lib/format'
import CheckedTag from './CheckedTag.astro'

interface Props {
  label: string
  /** What we show. Null means the funder's page does not say. */
  value: string | null
  evidence?: Evidence
  /** Shown instead of "Not found on the pages we read" when the value is null. */
  missing?: string
}

const { label, value, evidence, missing = 'Not found on the pages we read' } = Astro.props
const shown = value && label === 'Amount' ? keepAmountTogether(value) : value
---

<div class="grid grid-cols-[minmax(0,1fr)] gap-[0.35rem] border-t border-rule py-[1.1rem] md:grid-cols-[11rem_minmax(0,1fr)] md:gap-6">
  <dt class="pt-[0.15rem] text-md font-bold text-ink-2">{label}</dt>
  <dd class="m-0 min-w-0">
    {
      shown ? (
        // A long summary in our words reads as text, so it doesn't outweigh the quote under it.
        <p class:list={[shown.length > 70 ? 'text-base' : 'text-lg font-semibold']}>{shown}</p>
      ) : (
        <p class="text-lg text-ink-2">{missing}</p>
      )
    }
    <slot />
    {
      evidence && (
        <figure class="mt-[0.4rem]">
          {/* The funder's words hang off a rule, so the facts read as one list rather than a stack of boxes. */}
          <blockquote class="max-w-[65ch] border-l-3 border-rule-strong py-[0.1rem] pl-[0.85rem] text-[0.9875rem] text-ink" cite={evidence.source_url}>
            <p class="before:content-['“'] after:content-['”']">{evidence.quote}</p>
          </blockquote>
          {/* Every fact names its page and date, the same line each time. */}
          <figcaption class="mt-[0.45rem]">
            <CheckedTag checked={evidence.checked_at} source={{ url: evidence.source_url, label: pageLabel(evidence.source_url) }} />
          </figcaption>
        </figure>
      )
    }
  </dd>
</div>
