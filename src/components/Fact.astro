---
import type { Evidence } from '../data/schema'
import { keepAmountTogether, pageLabel } from '../lib/format'
import { notRecheckedPage } from '../lib/data'
import SourceLink from './SourceLink.astro'

interface Props {
  label: string
  /** What we show. Null means the funder's page does not say. */
  value: string | null
  evidence?: Evidence
  /** Shown instead of "Not found on the pages we read" when the value is null. */
  missing?: string
  /** Anchor for this fact, so a citation can link it (src/lib/agent.ts factIds). */
  id?: string
}

const { label, value, evidence, missing = 'Not found on the pages we read', id } = Astro.props
const shown = value && label === 'Amount' ? keepAmountTogether(value) : value
---

<div id={id} class="grid grid-cols-[minmax(0,1fr)] gap-[0.35rem] border-t border-rule py-[1.1rem] md:grid-cols-[11rem_minmax(0,1fr)] md:gap-6">
  <dt class="pt-[0.15rem] text-md font-bold text-ink-2">{label}</dt>
  <dd class="m-0 min-w-0">
    {
      shown ? (
        // A long summary in our words reads as text, so it doesn't outweigh the quote under it.
        <p class:list={[shown.length > 70 ? 'text-base' : 'text-lg font-semibold']}>{shown}</p>
      ) : (
        <p class="text-lg text-ink-2">{missing}</p>
      )
    }
    <slot />
    {
      evidence && (
        <figure class="mt-[0.4rem]">
          {/* The funder's words hang off a rule, so the facts read as one list rather than a stack of boxes. The
              source icon ends the quote, held to its last word; its tooltip names the page and date. */}
          <blockquote class="max-w-[65ch] border-l-3 border-rule-strong py-[0.1rem] pl-[0.85rem] text-[0.9875rem] text-ink" cite={evidence.source_url}>
            <p>
              <span class="before:content-['“'] after:content-['”']">{evidence.quote}</span>{'\u00a0'}<SourceLink
                url={evidence.source_url}
                label={pageLabel(evidence.source_url)}
                checked={evidence.checked_at}
                reason={notRecheckedPage(evidence.source_url)}
              />
            </p>
          </blockquote>
        </figure>
      )
    }
  </dd>
</div>
