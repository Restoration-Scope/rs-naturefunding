---
import type { Evidence } from '../data/schema'
import { keepAmountTogether, pageLabel } from '../lib/format'
import { notRecheckedPage } from '../lib/data'
import SourceLink from './SourceLink.astro'
import {
  Banknote,
  Building2,
  CalendarClock,
  CalendarPlus,
  CalendarRange,
  CircleDot,
  ClipboardList,
  DoorOpen,
  FileText,
  HandCoins,
  Landmark,
  MapPin,
  Network,
  Repeat,
  Sprout,
  Users,
} from 'lucide-react'

/** One icon per fact, so the list can be scanned by eye. Labels without one show none. */
const icons: Record<string, typeof Banknote> = {
  'How to apply': DoorOpen,
  Amount: Banknote,
  'Per project': Banknote,
  'Total budget': Landmark,
  Organisations: Users,
  'Work to apply': ClipboardList,
  Where: MapPin,
  'Who can apply': Users,
  Rounds: CalendarRange,
  'Co-funding required': HandCoins,
  'Consortium required': Network,
  'Run by': Building2,
  'Restoration approach': Sprout,
  Reporting: FileText,
  Status: CircleDot,
  Opens: CalendarPlus,
  Deadline: CalendarClock,
  'Dates each year': Repeat,
}

interface Props {
  label: string
  /** What we show. Null means the funder's page does not say. A `value` slot draws it instead (countries with their flags). */
  value: string | null
  /** One quote, or several when the page states the fact in more than one place. */
  evidence?: Evidence | Evidence[]
  /** Shown instead of "Not found on the pages we read" when the value is null. */
  missing?: string
  /** Anchor for this fact, so a citation can link it (src/lib/agent.ts factIds). */
  id?: string
}

const { label, value, evidence, missing = 'Not found on the pages we read', id } = Astro.props
const shown = value && (label === 'Amount' || label === 'Per project' || label === 'Total budget') ? keepAmountTogether(value) : value
const Icon = icons[label]
// A conditional value slot that renders nothing still counts as filled, so check what it draws.
const slotValue = Astro.slots.has('value') ? (await Astro.slots.render('value')).trim() : ''
const quotes = evidence ? (Array.isArray(evidence) ? evidence : [evidence]) : []
---

<div id={id} class="grid grid-cols-[minmax(0,1fr)] gap-[0.35rem] border-t border-rule py-[1.1rem] md:grid-cols-[11rem_minmax(0,1fr)] md:gap-6">
  <dt class="flex items-start gap-2 pt-[0.15rem] text-md font-bold text-ink-2">
    {Icon && <Icon className="mt-[0.2rem] size-4 flex-none text-(--tone,currentColor)" aria-hidden="true" />}
    <span>{label}</span>
  </dt>
  <dd class="m-0 min-w-0">
    {
      slotValue ? (
        <p class="text-lg font-semibold" set:html={slotValue} />
      ) : shown ? (
        // A long summary in our words reads as text, so it doesn't outweigh the quote under it.
        <p class:list={[shown.length > 70 ? 'text-base' : 'text-lg font-semibold']}>{shown}</p>
      ) : (
        <p class="text-lg text-ink-2">{missing}</p>
      )
    }
    <slot />
    {
      quotes.map((e) => (
        <figure class="mt-[0.4rem]">
          {/* The funder's words hang off a rule, so the facts read as one list rather than a stack of boxes. The
              source icon ends the quote, held to its last word; its tooltip names the page and date. */}
          <blockquote class="max-w-[65ch] border-l-3 border-rule-strong py-[0.1rem] pl-[0.85rem] text-[0.9875rem] text-ink" cite={e.source_url}>
            <p>
              <span class="before:content-['“'] after:content-['”']">{e.quote}</span>{'\u00a0'}<SourceLink
                url={e.source_url}
                label={pageLabel(e.source_url)}
                checked={e.checked_at}
                reason={notRecheckedPage(e.source_url)}
              />
            </p>
          </blockquote>
        </figure>
      ))
    }
  </dd>
</div>
