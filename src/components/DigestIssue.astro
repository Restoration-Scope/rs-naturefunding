---
// One past weekly email on the site (src/pages/digest/[date].astro): the same items, in the same order, as the
// email to someone who picked no country or project type, with the data as it stood that day.
import type { Issue } from '../../digest/scripts/issues'
import type { Section } from '../../digest/src/digest'
import { itemParts, sectionTitle } from '../../digest/src/email'
import { programmes } from '../lib/data'
import OrgMark from './OrgMark.astro'

interface Props {
  issue: Issue
}

const { issue } = Astro.props
const prefs = { where: '', approaches: [] }
// A programme taken off the site since keeps its line, without a link to a listing that is gone.
const listed = new Set(programmes.map((p) => p.id))
const sections = (['open', 'upcoming', 'new'] as Section[])
  .map((s) => [s, issue.digest.items.filter((i) => i.section === s)] as const)
  .filter(([, items]) => items.length > 0)
const more = issue.digest.total - issue.digest.items.length
const link = 'text-link underline underline-offset-2'
---

{
  sections.map(([s, items]) => (
    <section class="mt-8 first:mt-0">
      <h2 class="text-2xl font-extrabold">{sectionTitle[s]}</h2>
      <ul class="mt-2 list-none divide-y divide-rule border-y border-rule pl-0">
        {items.map((i) => {
          const x = itemParts(i, '', prefs)
          const page = listed.has(i.programme.id) ? x.page : null
          return (
            <li class="py-4">
              <p class="text-lg">
                <OrgMark org={i.programme.funder} size={16} class="mr-1.5 -mt-0.5" />
                {page ? <a class="text-ink underline decoration-ink-2 underline-offset-2" href={page}>{x.name}</a> : x.name}
                {x.funder && <span class="text-base text-ink-2"> · {x.funder}</span>}
              </p>
              <p class:list={['mt-2.5 w-fit rounded-xl border-[0.5px] border-rule bg-sunk px-3.5 py-2 leading-tight', x.amount ? 'text-2xl' : 'text-lg']}>
                {x.amount ? <strong class="font-bold">{x.amount.text}</strong> : <span class="text-ink-2">Amount not stated</span>}
              </p>
              {x.place && (
                <p class="mt-2 text-ink-2">
                  {x.flags.map((c) => <img class="mr-1 inline-block rounded-[2px] align-[-2px]" src={`/flags/${c}.svg`} width="21" height="14" alt="" />)}
                  {x.place}
                </p>
              )}
              {x.status && (
                <p class="mt-1.5">
                  <span class="font-semibold text-brand">{x.status}</span>
                  {x.callLabel && <span class="text-ink-2"> · {x.callLabel}</span>}
                </p>
              )}
              {x.types.length > 0 && (
                <p class="mt-2 flex flex-wrap gap-1.5 text-sm text-ink-2">
                  {x.types.map((t) => (
                    <span class="inline-flex items-center gap-1 rounded-full border-[0.5px] border-rule bg-sunk px-2 py-0.5">
                      <img src={`/icons/types/${t.key}-muted.svg`} width="14" height="14" alt="" />
                      {t.label}
                    </span>
                  ))}
                </p>
              )}
            </li>
          )
        })}
      </ul>
    </section>
  ))
}
{
  more > 0 && (
    <p class="mt-6">
      And {more} more. <a class={link} href="/">See all grants on naturefunding.org</a>.
    </p>
  )
}
