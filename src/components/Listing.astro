---
import type { Listing } from '../lib/data'
import { buildDate, daysBetween, sizeBucketsFor, whereCodes } from '../lib/data'
import { amountText, geographyText, keepAmountTogether, shortDate } from '../lib/format'
import { accessLabels, applicantLabels, approachLabels, stateLabels } from '../lib/labels'
import CheckedTag from './CheckedTag.astro'

interface Props {
  listing: Listing
  /** Listed on its parent's page, where the funder is already named. */
  underParent?: boolean
}

const { listing, underParent = false } = Astro.props
const { p, state, call } = listing
const deadline = call?.deadline ?? null
const amountRaw = amountText(p.amount)
const amount = amountRaw && keepAmountTogether(amountRaw)
const where = geographyText(p.geography)
const who = p.applicant_types?.map((a) => applicantLabels[a]).join(', ') ?? null

const noCallRoute = p.access === 'intermediary' || p.access === 'invitation_only'
const daysLeft = state === 'open' && deadline ? daysBetween(buildDate, deadline.date) : null
// An open call without a date: show the funder's yearly dates, or the label when it describes the window itself.
const undatedWindow =
  call?.recurring ?? (call?.label && /window|deadline|each year|until/i.test(call.label) ? call.label : null)
const route = p.access === 'direct' ? null : accessLabels[p.access]
const searchText = [
  p.name,
  p.funder.name,
  p.administered_by?.name,
  p.summary,
  where,
  p.approaches.map((a) => approachLabels[a]).join(' '),
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase()
---

<li
  class="listing"
  data-state={state}
  data-deadline={deadline?.date}
  data-opens={call?.opens ?? undefined}
  data-checked={p.checked_at}
  data-approach={p.approaches.join(' ')}
  data-applicant={p.applicant_types?.join(' ') ?? ''}
  data-access={p.access}
  data-where={whereCodes(p)}
  data-size={sizeBucketsFor(p).join(' ')}
  data-text={searchText}
>
  <div class="listing__status">
    <span class="tape" data-state={state}>
      {noCallRoute ? accessLabels[p.access] : stateLabels[state]}
    </span>
  </div>

  <div class="listing__main">
    <h3 class="listing__name"><a href={`/p/${p.id}/`}>{p.name}</a></h3>
    <p class="listing__funder">
      {
        underParent && p.administered_by ? (
          <>Run by {p.administered_by.name}</>
        ) : (
          <>
            {p.funder.name}
            {p.administered_by && <span>, run by {p.administered_by.name}</span>}
          </>
        )
      }
    </p>
    <p class="listing__meta">
      {p.kind === 'partnership' && <span>Paid partnership, not a grant</span>}
      {route && !noCallRoute && <span>{route}</span>}
      {where && <span><span class="listing__key">Where:</span> {where}</span>}
      {who && <span><span class="listing__key">Who:</span> {who}</span>}
    </p>
  </div>

  <div class="listing__deadline">
    <span class="listing__label">{state === 'upcoming' ? 'Opens' : 'Deadline'}</span>
    {
      state === 'open' && !deadline && (
        <span class="listing__value listing__value--muted listing__value--prose">{undatedWindow ?? 'Date not stated'}</span>
      )
    }
    {
      state === 'open' && deadline && (
        <span class="listing__value">
          {shortDate(deadline.date)}
          {daysLeft !== null && (
            <span class="listing__left mono" data-left data-soon={daysLeft < 7 ? '' : undefined}>
              {daysLeft === 0 ? 'Closes today' : daysLeft === 1 ? '1 day left' : `${daysLeft} days left`}
            </span>
          )}
          <span class="listing__quote" title={`The deadline as the funder wrote it: “${deadline.text}”`}>“{deadline.text}”</span>
        </span>
      )
    }
    {state === 'rolling' && <span class="listing__value">Any time</span>}
    {
      state === 'upcoming' && (
        <span class="listing__value">
          {call?.opens ? (
            shortDate(call.opens)
          ) : call?.expected ? (
            <>Expected {call.expected}</>
          ) : (
            <span class="listing__value--muted">Not dated yet</span>
          )}
          {deadline && <span class="listing__sub">Closes {shortDate(deadline.date)}</span>}
        </span>
      )
    }
    {
      state === 'closed' && (
        <span class="listing__value listing__value--muted">
          {deadline ? `Closed ${shortDate(deadline.date)}` : 'Closed'}
        </span>
      )
    }
    {
      state === 'none' && (
        <span class="listing__value listing__value--muted">
          {p.access === 'intermediary' ? 'Varies by partner' : call?.recurring ? 'No window open now' : 'No call found'}
          {call?.recurring && <span class="listing__sub">Each year: {call.recurring}</span>}
        </span>
      )
    }
  </div>

  <div class="listing__amount">
    <span class="listing__label">Amount</span>
    <span class={amount ? 'listing__value' : 'listing__value listing__value--muted'}>
      {amount ?? 'Not stated'}
      {amount && p.amount?.note && <span class="listing__sub">{p.amount.note}</span>}
    </span>
  </div>

  <div class="listing__check">
    <CheckedTag checked={p.checked_at} compact />
  </div>
</li>

<style>
  .listing {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'status status'
      'name name'
      'funder funder'
      'deadline amount'
      'meta meta'
      'check check';
    gap: 0.3rem 1rem;
    padding: 0.9rem 0 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .listing__status {
    grid-area: status;
  }
  /* Narrow containers: the name, deadline and amount come first; the rest of the main cell follows. */
  .listing__main {
    display: contents;
  }
  .listing__name {
    grid-area: name;
    text-wrap: pretty;
    margin-top: 0.25rem;
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.005em;
  }
  .listing__funder {
    grid-area: funder;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .listing__meta {
    grid-area: meta;
  }
  .listing__deadline {
    grid-area: deadline;
  }
  .listing__amount {
    grid-area: amount;
  }
  .listing__check {
    grid-area: check;
    position: relative;
    z-index: 1;
  }
  .listing__name a {
    color: var(--link);
    text-decoration: none;
  }
  /* The whole row opens the programme. */
  .listing__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .listing:hover .listing__name a,
  .listing__name a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .listing:hover {
    background: var(--surface);
  }
  .listing[data-state='closed'] .listing__value {
    color: var(--ink-2);
  }
  .listing[data-state='closed'] .listing__amount .listing__value {
    font-weight: 400;
  }
  /* Separators sit before each item; the ones that wrap to a line start are clipped away. */
  .listing__meta {
    display: flex;
    flex-wrap: wrap;
    margin-left: -1.25rem;
    clip-path: inset(0 0 0 1.25rem);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .listing__meta > span {
    position: relative;
    padding-left: 1.25rem;
  }
  .listing__meta > span::before {
    content: '·';
    position: absolute;
    left: 0;
    width: 1.25rem;
    text-align: center;
  }
  .listing__key {
    font-weight: 700;
  }
  .listing__deadline,
  .listing__amount {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-block: 0.35rem 0.15rem;
  }
  .listing__label {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .listing__value {
    font-weight: 600;
  }
  .listing__value--muted {
    font-weight: 400;
  }
  /* An undated window in the funder's words: the row's only deadline, so smaller but never clipped. */
  .listing__value--prose {
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .listing__value--muted {
    color: var(--ink-2);
  }
  .listing__left {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
  }
  /* Under a week left: the amber of an ageing stamp, so it reads as "act soon". */
  .listing__left[data-soon] {
    justify-self: start;
    width: fit-content;
    margin-top: 0.15rem;
    padding: 0 0.35rem;
    border-radius: 2px;
    background: var(--aging);
    color: var(--aging-ink);
  }
  .listing__quote,
  .listing__sub {
    display: block;
    margin-top: 0.15rem;
    font-weight: 400;
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .listing__quote {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* Wide containers: one row per programme, in columns under the finder's header.
     The tape and the stamp share the first line of the programme column. */
  @container listings (min-width: 52rem) {
    .listing {
      grid-template-columns: minmax(0, 1fr) 11rem 9rem;
      grid-template-areas:
        'status deadline amount'
        'name deadline amount'
        'funder deadline amount'
        'meta deadline amount';
      grid-template-rows: auto auto auto 1fr;
      column-gap: 2rem;
      row-gap: 0.15rem;
      padding: 0.9rem 0.75rem 1rem;
    }
    .listing__check {
      grid-area: status;
      justify-self: end;
      align-self: center;
    }
    .listing__name {
      margin-top: 0.3rem;
      font-size: 1.125rem;
    }
    .listing__deadline,
    .listing__amount {
      margin: 0;
      padding-top: 1.85rem;
    }
    .listing__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    /* The column is headed Deadline; an upcoming row says its date is the opening. */
    .listing[data-state='upcoming'] .listing__deadline .listing__label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      font-weight: 700;
    }
    .listing[data-state='upcoming'] .listing__deadline {
      padding-top: 0.65rem;
    }
  }
</style>
