---
import type { Listing } from '../lib/data'
import { buildDate, daysBetween, sizeBucketsFor, whereCodes } from '../lib/data'
import { amountText, geographyText, keepAmountTogether, shortDate } from '../lib/format'
import { accessLabels, applicantLabels, approachLabels, stateLabels } from '../lib/labels'
import { Badge } from '@/components/ui/badge'
import CheckedTag from './CheckedTag.astro'
import OrgMark from './OrgMark.astro'
import Route from './Route.astro'

interface Props {
  listing: Listing
  /** Listed on its parent's page, where the funder is already named. */
  underParent?: boolean
}

const { listing, underParent = false } = Astro.props
const { p, state, call } = listing
const deadline = call?.deadline ?? null
const amountRaw = amountText(p.amount)
const amount = amountRaw && keepAmountTogether(amountRaw)
const where = geographyText(p.geography)
const who = p.applicant_types?.map((a) => applicantLabels[a]).join(', ') ?? null

const noCallRoute = p.access === 'intermediary' || p.access === 'invitation_only'
const daysLeft = state === 'open' && deadline ? daysBetween(buildDate, deadline.date) : null
// An open call without a date: show the funder's yearly dates, or the label when it describes the window itself.
const undatedWindow =
  call?.recurring ?? (call?.label && /window|deadline|each year|until/i.test(call.label) ? call.label : null)
// The funder's own words for yearly dates, shown under our summary of them.
const recurringQuote = call?.recurring ? (call.evidence.recurring?.quote ?? null) : null
const route = p.access === 'direct' ? null : accessLabels[p.access]
const closed = state === 'closed'
// Wide containers (52rem and up): one row per programme, in columns; the labels hide, except an
// upcoming row's, which says its date is the opening.
const label = (upcoming: boolean) =>
  upcoming
    ? 'text-xs text-ink-2 @min-[52rem]/listings:font-bold'
    : 'text-xs text-ink-2 @min-[52rem]/listings:sr-only'
const cell = 'mt-[0.35rem] mb-[0.15rem] flex flex-col gap-[0.1rem] @min-[52rem]/listings:m-0'
const value = closed ? 'font-semibold text-ink-2' : 'font-semibold'
const muted = 'font-normal text-ink-2'
const sub = 'mt-[0.15rem] block text-sm leading-[1.4] font-normal text-ink-2'
const searchText = [
  p.name,
  p.funder.name,
  p.administered_by?.name,
  p.summary,
  where,
  p.approaches.map((a) => approachLabels[a]).join(' '),
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase()
---

<li
  class:list={[
    'group/listing relative grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-x-4 gap-y-[0.3rem] border-b border-rule pt-[0.9rem] pb-4 hover:bg-muted/50',
    "[grid-template-areas:'status_status'_'name_name'_'funder_funder'_'deadline_amount'_'meta_meta'_'check_check']",
    // Narrow phones: deadline and amount stack, so a long quote keeps the full width.
    "@max-[29.99rem]/listings:grid-cols-[minmax(0,1fr)] @max-[29.99rem]/listings:[grid-template-areas:'status'_'name'_'funder'_'deadline'_'amount'_'meta'_'check']",
    // Wide: the status and the checked date share the first line of the programme column.
    "@min-[52rem]/listings:grid-cols-[minmax(0,1fr)_11rem_9rem] @min-[52rem]/listings:grid-rows-[auto_auto_auto_1fr] @min-[52rem]/listings:gap-x-8 @min-[52rem]/listings:gap-y-[0.15rem] @min-[52rem]/listings:px-3",
    "@min-[52rem]/listings:[grid-template-areas:'status_deadline_amount'_'name_deadline_amount'_'funder_deadline_amount'_'meta_deadline_amount']",
  ]}
  data-state={state}
  data-deadline={deadline?.date}
  data-opens={call?.opens ?? undefined}
  data-checked={p.checked_at}
  data-approach={p.approaches.join(' ')}
  data-applicant={p.applicant_types?.join(' ') ?? ''}
  data-access={p.access}
  data-where={whereCodes(p)}
  data-size={sizeBucketsFor(p).join(' ')}
  data-text={searchText}
>
  <div class="[grid-area:status]">
    <span class="flex flex-wrap items-center gap-2">
      {!(state === 'none' && noCallRoute) && <Badge variant="status" state={state}>{stateLabels[state]}</Badge>}
      {noCallRoute && <Route access={p.access} />}
    </span>
  </div>

  {/* Narrow containers: the name, deadline and amount come first; the rest of this cell follows. */}
  <div class="contents">
    <h3 class="mt-1 text-[1.3125rem] text-pretty [grid-area:name] @min-[52rem]/listings:mt-[0.3rem] @min-[52rem]/listings:text-3xl">
      {/* The whole row opens the programme. */}
      <a
        class="text-link no-underline decoration-2 underline-offset-[0.18em] group-hover/listing:underline after:absolute after:inset-0 after:content-[''] focus-visible:underline"
        href={`/p/${p.id}/`}>{p.name}</a
      >
    </h3>
    <p class="leading-[1.45] text-ink-2 [grid-area:funder]">
      {
        underParent && p.administered_by ? (
          <><OrgMark org={p.administered_by} class="mr-2 -mt-0.5" />Run by {p.administered_by.name}</>
        ) : (
          <>
            <OrgMark org={p.funder} class="mr-2 -mt-0.5" />
            {p.funder.name}
            {p.administered_by && <span>, run by {p.administered_by.name}</span>}
          </>
        )
      }
    </p>
    {/* Separators sit before each item; the ones that wrap to a line start are clipped away. */}
    <p class="-ml-5 flex flex-wrap text-md leading-[1.45] text-ink-2 [clip-path:inset(0_0_0_1.25rem)] [grid-area:meta] *:relative *:pl-5 *:before:absolute *:before:left-0 *:before:w-5 *:before:text-center *:before:content-['·']">
      {p.kind === 'partnership' && <span>Paid partnership, not a grant</span>}
      {route && !noCallRoute && <span>{route}</span>}
      {where && <span><span class="font-bold">Where:</span> {where}</span>}
      {who && <span><span class="font-bold">Who:</span> {who}</span>}
    </p>
  </div>

  <div class:list={[cell, '[grid-area:deadline]', state === 'upcoming' ? '@min-[52rem]/listings:pt-[0.65rem]' : '@min-[52rem]/listings:pt-[1.85rem]']}>
    <span class={label(state === 'upcoming')}>{state === 'upcoming' ? 'Opens' : 'Deadline'}</span>
    {
      state === 'open' && !deadline && (
        // An undated window in the funder's words: the row's only deadline, so smaller but never clipped.
        <span class:list={[muted, 'text-md leading-[1.4]']}>
          {undatedWindow ?? 'Date not stated'}
          {recurringQuote && <span class={sub}>“{recurringQuote}”</span>}
        </span>
      )
    }
    {
      state === 'open' && deadline && (
        <span class={value}>
          {shortDate(deadline.date)}
          {daysLeft !== null && (
            <span
              class:list={[
                'block',
                // A week or less left: an amber badge, so it reads as "act soon".
                daysLeft <= 7 ? 'mt-1 w-fit rounded-md bg-warn px-2 py-0.5 text-xs font-medium text-warn-ink' : 'text-sm font-normal text-muted-foreground',
              ]}
              data-left
              data-soon={daysLeft <= 7 ? '' : undefined}
            >
              {daysLeft === 0 ? 'Closes today' : daysLeft === 1 ? '1 day left' : `${daysLeft} days left`}
            </span>
          )}
          <span class={sub} title={`The deadline as the funder wrote it: “${deadline.text}”`}>“{deadline.text}”</span>
        </span>
      )
    }
    {state === 'rolling' && <span class={value}>Any time</span>}
    {
      state === 'upcoming' && (
        <span class={value}>
          {call?.opens ? (
            shortDate(call.opens)
          ) : call?.expected ? (
            <>Expected {call.expected}</>
          ) : (
            <span class={muted}>Not dated yet</span>
          )}
          {deadline && <span class={sub}>Closes {shortDate(deadline.date)}</span>}
        </span>
      )
    }
    {
      state === 'closed' && (
        <span class={muted}>
          {deadline ? `Closed ${shortDate(deadline.date)}` : 'Closed'}
          {deadline && <span class={sub}>“{deadline.text}”</span>}
        </span>
      )
    }
    {
      state === 'none' && (
        <span class={muted}>
          {p.access === 'intermediary' ? 'Varies by partner' : call?.recurring ? 'Page doesn’t say if open now' : 'No call found'}
          {call?.recurring && <span class={sub}>Each year: {call.recurring}</span>}
          {recurringQuote && <span class={sub}>“{recurringQuote}”</span>}
        </span>
      )
    }
  </div>

  <div class:list={[cell, '[grid-area:amount] @min-[52rem]/listings:pt-[1.85rem]']}>
    <span class={label(false)}>Amount</span>
    <span class:list={[amount && !closed ? 'font-semibold' : muted]}>
      {amount ?? 'Not stated'}
      {amount && p.amount?.note && <span class={sub}>{p.amount.note}</span>}
    </span>
  </div>

  <div class="relative z-1 [grid-area:check] @min-[52rem]/listings:self-center @min-[52rem]/listings:justify-self-end @min-[52rem]/listings:[grid-area:status]">
    <CheckedTag checked={p.checked_at} />
  </div>
</li>
