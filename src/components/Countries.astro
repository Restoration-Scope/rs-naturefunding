---
import Flag from './Flag.astro'
import { countryName, countryRegion } from '../lib/geo'

// Countries by name, each after its flag, so a list of them scans by eye: "Belize, Costa Rica and Panama".
interface Props {
  codes: string[]
  /** The part of a country, where the funder takes only part: after its name, in brackets. */
  parts?: Record<string, string>
}
const { codes, parts = {} } = Astro.props
const sep = (i: number) => (i === 0 ? '' : i === codes.length - 1 ? ' and ' : ', ')
---

{codes.map((code, i) => <>{sep(i)}<span class="whitespace-nowrap">{countryRegion[code] && <Flag code={code} class="mr-[0.3em]" />}{countryName(code)}</span>{parts[code] && ` (only ${parts[code]})`}</>)}
