---
import type { Listing } from '../lib/data'
import { AGING_DAYS, buildDate, daysBetween, listingFor, notRechecked, opensSortDate, programmes, sizeBucketsFor, whereCodes } from '../lib/data'
import { amountText, geographyText, longDate, shortDate } from '../lib/format'
import { approachLabels, recheckReasons, stateLabels } from '../lib/labels'
import { compactAmount, usdValue } from '../lib/table'
import { Badge } from '@/components/ui/badge'
import { TableCell, TableRow } from '@/components/ui/table'
import OrgMark from './OrgMark.astro'
import Route from './Route.astro'

interface Props {
  listing: Listing
}

const { listing } = Astro.props
const { p, state, call, aging } = listing
const deadline = call?.deadline ?? null
const amountFull = amountText(p.amount)
// A range never breaks at its dash; the line may break before the currency code instead.
const amount = compactAmount(p.amount)?.replace(/–/g, '–\u2060').replace(/\u00a0([A-Z]{3})/, ' $1') ?? null
const usd = usdValue(p.amount)
const where = geographyText(p.geography)
const daysLeft = state === 'open' && deadline ? daysBetween(buildDate, deadline.date) : null
// An open call without a date: the funder's yearly dates, or the label when it describes the window itself.
const undatedWindow =
  call?.recurring ?? (call?.label && /window|deadline|each year|until/i.test(call.label) ? call.label : null)
// Rows without a date still show the funder's own words on when to apply.
const statusWords = !call || deadline
  ? null
  : call.recurring && (state === 'open' || state === 'none')
    ? (call.evidence.recurring?.quote ?? null)
    : state === 'rolling' || state === 'upcoming' || (state === 'open' && !undatedWindow)
      ? (call.evidence.opens?.quote ?? call.evidence.status.quote)
      : null
// An umbrella that funds through partners: how many of its partner programmes are open now.
const openPartners =
  p.access === 'intermediary'
    ? programmes.filter((c) => c.parent === p.id).filter((c) => ['open', 'rolling'].includes(listingFor(c).state)).length
    : 0
const funder = p.administered_by ? `${p.funder.name}, run by ${p.administered_by.name}` : p.funder.name
const left = (n: number) => (n === 0 ? 'Closes today' : n === 1 ? '1 day left' : `${n} days left`)
const reason = notRechecked(p.id)
const stampTitle = reason
  ? `Last read on the funder’s page on ${longDate(p.checked_at)}. Our daily check can’t read it now: ${recheckReasons[reason]}.`
  : `Checked against the funder’s page on ${longDate(p.checked_at)}${aging ? `. Over ${AGING_DAYS} days ago, due a recheck.` : ''}`
const stampText = `${reason ? 'Last confirmed' : 'Checked'} ${shortDate(p.checked_at)}`
const searchText = [p.name, p.funder.name, p.administered_by?.name, p.summary, where, p.approaches.map((a) => approachLabels[a]).join(' ')]
  .filter(Boolean)
  .join(' ')
  .toLowerCase()
---

{/* Row internals are styled by class in src/styles/finder.css, which also reflows them at narrow widths. */}
<TableRow
  className="row"
  data-state={state}
  data-deadline={deadline?.date}
  data-opens={opensSortDate(call)}
  data-checked={p.checked_at}
  data-usd={usd ?? undefined}
  data-name={p.name.toLowerCase()}
  data-approach={p.approaches.join(' ')}
  data-applicant={p.applicant_types?.join(' ') ?? ''}
  data-access={p.access}
  data-where={whereCodes(p)}
  data-size={sizeBucketsFor(p).join(' ')}
  data-text={searchText}
>
  <TableCell className="c-prog">
    <a class="name" href={`/p/${p.id}/`}>{p.name}</a>
    <span class="sub" title={funder}><OrgMark org={p.funder} size={16} class="sub__mark" />{funder}</span>
    {/* Most programmes take direct applications, so only the other routes get a line (src/styles/finder.css). */}
    <span class="sub__route"><Route access={p.access} /></span>
    {p.kind === 'partnership' && <span class="kind">Paid partnership, not a grant</span>}
  </TableCell>

  <TableCell className="c-dl">
    {/* Line 1: the status and its date. Line 2: days left. Then the funder's words. */}
    <span class="dl">
      <Badge variant="status" state={state}>{stateLabels[state]}</Badge>
      {
        state === 'open' && deadline && (
          <>
            <span class="dl__date">{shortDate(deadline.date)}</span>
            {daysLeft !== null && (
              <span class="dl__left" data-left data-soon={daysLeft <= 7 ? '' : undefined}>
                {left(daysLeft)}
              </span>
            )}
          </>
        )
      }
      {state === 'open' && !deadline && !undatedWindow && <span class="dl__muted">Date not stated</span>}
      {state === 'rolling' && <span class="dl__date">Any time</span>}
      {
        state === 'upcoming' &&
          (call?.opens ? (
            <span class="dl__date">Opens {shortDate(call.opens)}</span>
          ) : call?.expected ? (
            <span class="dl__date">Expected {call.expected}</span>
          ) : (
            <span class="dl__muted">Not dated yet</span>
          ))
      }
      {state === 'closed' && deadline && <span class="dl__muted">{shortDate(deadline.date)}</span>}
      {
        state === 'none' && (p.access === 'intermediary' || call?.recurring) && (
          <span class="dl__muted">
            {p.access === 'intermediary'
              ? openPartners > 0
                ? `${openPartners} partner programme${openPartners === 1 ? '' : 's'} open now`
                : 'Varies by partner'
              : 'Page doesn’t say if open now'}
          </span>
        )
      }
    </span>
    {
      state === 'open' && deadline && (
        <span class="dl__words" data-words title={`The deadline as the funder wrote it: “${deadline.text}”`}>
          <span class="sr-only">The funder wrote: </span>“{deadline.text}”
        </span>
      )
    }
    {state === 'open' && !deadline && undatedWindow && <span class="dl__words">{undatedWindow}</span>}
    {
      statusWords && (
        <span class="dl__words dl__words--quote" title={`As the funder wrote it: “${statusWords}”`}>
          <span class="sr-only">The funder wrote: </span>“{statusWords}”
        </span>
      )
    }
    {
      state === 'upcoming' && deadline && (
        <span class="dl__words" title={`The deadline as the funder wrote it: “${deadline.text}”`}>
          Closes {shortDate(deadline.date)}: “{deadline.text}”
        </span>
      )
    }
    {/* Our summary of the yearly window, only when the funder's own words aren't shown above. */}
    {state === 'none' && call?.recurring && !statusWords && <span class="dl__words">Each year: {call.recurring}</span>}
    {
      state === 'closed' && deadline && (
        <span class="dl__words dl__words--quote" title={`The deadline as the funder wrote it: “${deadline.text}”`}>
          <span class="sr-only">The funder wrote: </span>“{deadline.text}”
        </span>
      )
    }
  </TableCell>

  <TableCell className="c-amount" title={amountFull ?? 'The funder’s page does not state an amount'}>
    {amount ? <span class="amt">{amount}</span> : <span class="amt amt--none">Amount not stated</span>}
    {amount && p.amount?.note && <span class="amt__note">{p.amount.note}</span>}
    <Badge variant="tag" className="stamp" data-aging={aging || reason ? '' : undefined} title={stampTitle}>
      {stampText}
    </Badge>
  </TableCell>
</TableRow>
