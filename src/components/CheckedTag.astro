---
import { ExternalLink } from 'lucide-react'
import { Badge } from '@/components/ui/badge'
import { AGING_DAYS, buildDate, daysBetween, type RecheckFailure } from '../lib/data'
import { recheckReasons } from '../lib/labels'
import { longDate, shortDate } from '../lib/format'

interface Props {
  checked: string
  /** The page it was checked against, as an icon link before the date; the label is its tooltip. */
  source?: { url: string; label: string }
  /** The daily check could not re-read the programme since `checked`. */
  reason?: RecheckFailure | null
  class?: string
}

const { checked, source, reason, class: className } = Astro.props
const age = daysBetween(checked, buildDate)
const aging = age > AGING_DAYS
const title = reason
  ? `Last read on the funder’s page on ${longDate(checked)}. Our daily check can’t read it now: ${recheckReasons[reason]}.`
  : `Checked against the funder's page on ${longDate(checked)}`
---

<span class:list={['inline-flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-muted-foreground', className]} data-checked={checked}>
  {
    source && (
      <a
        class="inline-flex size-4 items-center justify-center rounded-sm text-muted-foreground hover:text-ink"
        href={source.url}
        target="_blank"
        rel="noopener"
        title={`Source: ${source.label}`}
        aria-label={`Source: ${source.label} (opens in a new tab)`}
      >
        <ExternalLink className="size-3.5" aria-hidden="true" />
      </a>
    )
  }
  <span class="inline-flex items-center whitespace-nowrap">
    <Badge variant="tag" data-aging={aging || reason ? '' : undefined} title={title}>{`${reason ? 'Last confirmed' : 'Checked'} ${shortDate(checked)}`}</Badge>
  </span>
  {/* Rendered only when true: hidden text still reaches agents that read the page as text. */}
  {aging && !reason && <span class="font-semibold text-aging-text">Over {AGING_DAYS} days ago, due a recheck</span>}
</span>
