---
import { Badge } from '@/components/ui/badge'
import { AGING_DAYS, buildDate, daysBetween } from '../lib/data'
import { longDate, shortDate } from '../lib/format'

interface Props {
  checked: string
  /** Print the page it was checked against after the tag. */
  source?: { url: string; label: string }
  class?: string
}

const { checked, source, class: className } = Astro.props
const age = daysBetween(checked, buildDate)
const aging = age > AGING_DAYS
---

<span class:list={['inline-flex flex-wrap items-center gap-x-2 gap-y-[0.3rem] text-sm text-ink-2', className]} data-checked={checked}>
  <Badge variant="tag" data-aging={aging ? '' : undefined} title={`Checked against the funder's page on ${longDate(checked)}`}>Checked {shortDate(checked)}</Badge>
  <span class="font-bold text-aging-text" hidden={!aging}>Over {AGING_DAYS} days ago, due a recheck</span>
  {
    source && (
      <span>
        Source: <a class="wrap-anywhere" href={source.url}>{source.label}</a>
      </span>
    )
  }
</span>
