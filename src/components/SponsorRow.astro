---
import { Badge } from '@/components/ui/badge'
import { TableBody, TableCell, TableRow } from '@/components/ui/table'
import { Check, ChevronDown, CircleDashed, ExternalLink, X } from 'lucide-react'
import type { Sponsor } from '../data/sponsors'
import { countryName } from '../lib/geo'
import { sponsorAnswerLabels, sponsorGrantLabels, sponsorIntakeLabels } from '../lib/labels'
import Flag from './Flag.astro'

/** One fiscal sponsor in the comparison under a project type: the answers that rule it in or out, with their
    conditions in full, and a row below with how to apply, grants and every charge. */
interface Props {
  s: Sponsor
}
const { s } = Astro.props

const marks = {
  yes: { Icon: Check, tone: 'text-ok-dot' },
  case_by_case: { Icon: CircleDashed, tone: 'text-caution-ink' },
  no: { Icon: X, tone: 'text-warn-dot' },
} as const
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1)

// `where` and `own_entity` answer none of these three, so they stand with what it takes and the answer stays "Not said".
const answers = [
  { label: 'Groups based abroad', a: s.foreign },
  { label: 'Companies', a: s.companies },
  { label: 'Individuals', a: s.individuals },
]
const asks = [
  { label: 'Check first', text: s.gate?.value },
  { label: 'Where', text: s.where?.value },
  { label: 'With your own organisation', text: s.own_entity?.value },
  { label: 'Funding or budget', text: s.min_income?.value },
].filter((x) => x.text)
const fees = (s.fees ?? []).map((f) => f.value)
// A lone third charge takes no more room than "and 1 more".
const shown = fees.length === 3 ? 3 : 2
const steps = (s.steps ?? []).map((f) => f.value)
const grantLead = s.grants ? sponsorGrantLabels[s.grants.value.role] : 'Not said'
---

{/* Styled by class in fiscal-sponsors.astro, which also reflows each sponsor to a card at narrow widths. */}
<TableBody>
  <TableRow>
    <th scope="row">
      <a class="sp-name" href={`#${s.id}`}>{s.name}</a>
      <p class="sp-sub">
        <span class="whitespace-nowrap"><Flag code={s.country.value} class="mr-[0.4em]" />{countryName(s.country.value)}<span class="sr-only">. </span></span>
        {s.intake && s.intake.value.status !== 'open' && <Badge variant="warn">{sponsorIntakeLabels[s.intake.value.status]}<span class="sr-only">. </span></Badge>}
      </p>
    </th>
    <TableCell data-label="Takes">
      <p>{s.projects.value}</p>
      {asks.map((x) => <p><strong>{x.label}:</strong> {x.text}</p>)}
    </TableCell>
    <TableCell data-label="Charges">
      {fees.length === 0 && <p class="text-ink-2">Not said</p>}
      {fees.slice(0, shown).map((f) => <p>{f}</p>)}
      {fees.length > shown && <p class="text-ink-2">and {fees.length - shown} more</p>}
    </TableCell>
    {
      answers.map(({ label, a }) => {
        const m = a && marks[a.value.answer]
        return (
          <TableCell data-label={label}>
            {a && m ? <p class="sp-answer"><m.Icon aria-hidden="true" className={`sp-mark ${m.tone}`} />{sponsorAnswerLabels[a.value.answer]}</p> : <p class="text-ink-2">Not said</p>}
            {a?.value.note && <p>{cap(a.value.note)}</p>}
          </TableCell>
        )
      })
    }
    <TableCell className="sp-open" data-twin-skip>
      <details data-sp-toggle>
        <summary>Details<span class="sr-only">: {s.name}</span><ChevronDown aria-hidden="true" /></summary>
      </details>
    </TableCell>
  </TableRow>
  {/* The twin reads the same facts from the cards below the tables. */}
  <TableRow className="sp-more" data-twin-skip>
    <TableCell colSpan={7}>
      <div class="sp-more__grid">
        <div>
          <p class="sp-more__label">How to apply</p>
          {steps.length > 0 ? <ol>{steps.map((x) => <li>{x}</li>)}</ol> : <p class="text-ink-2">Not said</p>}
        </div>
        <div>
          <p class="sp-more__label">Named applicant on a grant</p>
          <p class:list={grantLead === 'Not said' ? 'text-ink-2' : 'font-semibold'}>{grantLead}</p>
          {s.grants && <p>{s.grants.value.note}</p>}
          <p class="sp-more__label mt-3">Funding or budget asked for</p>
          <p class:list={{ 'text-ink-2': !s.min_income }}>{s.min_income?.value ?? 'Not said'}</p>
        </div>
        <div>
          <p class="sp-more__label">Charges</p>
          {fees.length > 0 ? <ul>{fees.map((x) => <li>{x}</li>)}</ul> : <p class="text-ink-2">Not said</p>}
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
            <a href={s.url} target="_blank" rel="noopener" class="whitespace-nowrap">Its page <ExternalLink aria-hidden="true" className="inline size-3.5 align-[-0.1em]" /><span class="sr-only"> (opens in a new tab)</span></a>
            <a href={`#${s.id}`} class="whitespace-nowrap">Every fact, in its own words</a>
          </p>
        </div>
      </div>
    </TableCell>
  </TableRow>
</TableBody>
