---
// The weekly-email prompt: a dialog that opens halfway down a page (src/lib/subscribe-prompt.ts decides when).
// Base.astro renders it on every page but the weekly email's own and the 404; its script runs on all of them, so a
// sign-up from any form, or the confirmation page, stops the prompt. Astro inlines the script (about 1 KB).
import DigestSignup from './DigestSignup.astro'
import { DIGEST_LIVE } from '../lib/site'

interface Props {
  show: boolean
}
const { show } = Astro.props
const render = show && (DIGEST_LIVE || import.meta.env.DEV)
---

{
  render && (
    <dialog
      data-subscribe-prompt
      aria-labelledby="subscribe-prompt-title"
      class="subscribe-prompt m-auto w-[calc(100%-2rem)] max-w-[30rem] overflow-visible bg-transparent p-0 text-ink backdrop:bg-black/45"
    >
      <div class="relative rounded-2xl bg-surface px-6 pt-8 pb-6 shadow-2xl sm:px-9 sm:pt-10 sm:pb-8">
        <form method="dialog">
          <button
            type="submit"
            class="absolute top-3 right-3 grid size-11 cursor-pointer place-items-center rounded-full text-ink-2 hover:bg-sunk hover:text-ink"
            aria-label="Close"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </button>
        </form>
        <div class="mx-auto grid size-16 place-items-center rounded-full bg-shell text-brand-light">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="30" height="30">
            <path d="M12 2.5c-4.6 3.4-7 7-7 10.6a7 7 0 0 0 14 0c0-3.6-2.4-7.2-7-10.6Z" fill="currentColor" />
            <path class="stroke-shell" d="M12 21.5V9.5m0 4.5 3.2-2.6M12 17l-3.4-2.8" fill="none" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </div>
        <h2 id="subscribe-prompt-title" class="mt-5 text-center text-2xl font-semibold tracking-[-0.01em]">New funding calls by email</h2>
        <p class="mx-auto mt-2 max-w-[34ch] text-center text-ink-2">
          Restoration and conservation grants, checked against each funder’s own page. At most once a week, only when a call opens or a programme is added.
        </p>
        <div class="mt-6">
          <DigestSignup bare id="digest-prompt" />
        </div>
      </div>
    </dialog>
  )
}

<script>
  import { initSubscribePrompt } from '../lib/subscribe-prompt'
  initSubscribePrompt()
</script>

<style>
  /* Fades and rises in; no motion for readers who ask for less. */
  .subscribe-prompt[open] {
    animation: subscribe-prompt-in 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .subscribe-prompt[open]::backdrop {
    animation: subscribe-prompt-fade 0.28s ease-out;
  }
  @keyframes subscribe-prompt-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
  }
  @keyframes subscribe-prompt-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .subscribe-prompt[open],
    .subscribe-prompt[open]::backdrop {
      animation: none;
    }
  }
</style>
