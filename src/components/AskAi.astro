---
// Ask your AI: a line about the project, handed to the visitor's own assistant with a prompt that starts it on the
// right list (src/lib/ask-ai.ts). No server and no AI of ours. The script loads when the box first opens.
// PostHog never reads the text: buttons, not links, carry it, and the field is ph-no-capture.
import { ChevronDown, Copy, ExternalLink, MessageSquareText } from 'lucide-react'
import { Button } from '@/components/ui/button'
---

<details class="group/ai border-t border-border" data-ask-ai-box>
  <summary class="flex min-h-12 cursor-pointer list-none items-center gap-2 rounded-b-2xl px-5 py-3 text-[0.9375rem] font-medium hover:bg-muted group-open/ai:rounded-none max-md:px-4 max-md:text-sm [&::-webkit-details-marker]:hidden">
    <MessageSquareText className="size-5 shrink-0" strokeWidth={1.75} aria-hidden="true" />
    <span>Ask your AI which grants fit your project</span>
    <ChevronDown className="ml-auto size-5 shrink-0 text-muted-foreground group-open/ai:rotate-180" aria-hidden="true" />
  </summary>
  <div class="px-4 pt-1 pb-4 max-md:px-3">
    <label class="mb-1.5 block px-1 text-sm font-medium" for="ask-ai-text">Your project: where, what, who you are and how much you need</label>
    <textarea
      id="ask-ai-text"
      class="ph-no-capture block w-full rounded-xl border border-border bg-transparent px-4 py-3 text-md text-foreground placeholder:text-muted-foreground"
      rows="3"
      maxlength="1200"
      autocomplete="off"
      placeholder="We are a community group in Kenya restoring 200 ha of mangroves. We need about $50,000."></textarea>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <Button type="button" className="max-md:h-11 max-md:flex-1" data-ask-ai="chatgpt">Ask ChatGPT<ExternalLink aria-hidden="true" /></Button>
      <Button type="button" className="max-md:h-11 max-md:flex-1" data-ask-ai="claude">Ask Claude<ExternalLink aria-hidden="true" /></Button>
      <Button type="button" variant="outline" className="max-md:h-11 max-md:basis-full" data-ask-ai="copy"><Copy aria-hidden="true" />Copy for another assistant</Button>
    </div>
    <p class="mt-2 px-1 text-sm text-ink-2" aria-live="polite" data-ask-ai-status></p>
    <p class="mt-1 px-1 text-sm text-ink-2">Opens in your own account with your text filled in; press send there. We never see it. AI can be wrong: check the funder’s page before you apply.</p>
    <noscript><p class="mt-1 px-1 text-sm text-ink-2">These buttons need JavaScript.</p></noscript>
  </div>
</details>

<script>
  const box = document.querySelector<HTMLDetailsElement>('[data-ask-ai-box]')!
  const load = () => import('../lib/ask-ai').then((m) => m.initAskAi(box))
  // Opened before this script ran (a restored page, a quick tap), or later.
  if (box.open) load()
  else box.addEventListener('toggle', load, { once: true })
</script>
