---
import '../styles/global.css'
import { RS_URL, REPO_URL, SITE_NAME, absolute, generalIssueUrl } from '../lib/site'

interface Props {
  title: string
  description: string
  path: string
  jsonLd?: object | object[]
  /** The finder itself; its link in the nav is marked current. */
  nav?: 'finder' | 'about' | 'data' | null
  noindex?: boolean
}

const { title, description, path, jsonLd, nav = null, noindex = false } = Astro.props
const canonical = absolute(path)
const fullTitle = path === '/' ? title : `${title} · ${SITE_NAME}`
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-serif-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/atom+xml" title="New and changed calls" href="/feed.xml" />
    <link rel="alternate" type="application/json" title="All listings (JSON)" href="/data.json" />
    <meta name="theme-color" content="#254b36" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="naturefunding.org: grants for nature restoration, checked against each funder's own page" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="absolute -top-16 left-4 z-10 rounded-md bg-surface px-3.5 py-2 text-ink focus:top-3" href="#main">Skip to content</a>
    <header class="bg-shell text-shell-ink [&_:focus-visible]:outline-brand-light [&_a]:text-inherit">
      <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3.5">
        <a class="inline-flex items-center gap-[0.45rem] font-serif text-2xl font-normal [font-synthesis-weight:none] no-underline" href="/" aria-label="naturefunding.org, home">
          <svg class="text-brand-light" viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
            <path d="M12 2.5c-4.6 3.4-7 7-7 10.6a7 7 0 0 0 14 0c0-3.6-2.4-7.2-7-10.6Z" fill="currentColor" opacity=".38" />
            <path d="M12 21.5V9.5m0 4.5 3.2-2.6M12 17l-3.4-2.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <span>naturefunding<span class="text-shell-ink-2">.org</span></span>
        </a>
        <nav aria-label="Main">
          <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 text-md">
            {
              [
                ['/', 'Find funding', 'finder'],
                ['/about/', 'How we check', 'about'],
                ['/about/#open-data', 'Open data', 'data'],
              ].map(([href, text, key]) => (
                <li>
                  <a
                    class="inline-block py-[0.35rem] text-shell-ink-2! no-underline decoration-brand-light decoration-2 underline-offset-[0.35em] hover:text-shell-ink! hover:underline aria-[current=page]:text-shell-ink! aria-[current=page]:underline"
                    href={href}
                    aria-current={nav === key ? 'page' : undefined}
                  >
                    {text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <slot name="band" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-20 border-t border-rule bg-sunk text-md text-ink-2-on-linen [&_a]:text-ink">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-x-12 gap-y-4 pt-8 pb-10 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)]">
        <p>
          Built and maintained by <a href={RS_URL}>Restoration Scope</a>, which makes monitoring software for
          restoration projects. Listings are free, and funders can’t pay to be listed or ranked.
        </p>
        <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-[0.35rem] p-0">
          <li><a href="/about/">How we check</a></li>
          <li><a href="/data.json">data.json</a></li>
          <li><a href="/data.csv">data.csv</a></li>
          <li><a href="/feed.xml">Atom feed</a></li>
          <li><a href={REPO_URL}>Source on GitHub</a></li>
          <li><a href={generalIssueUrl}>Report a problem</a></li>
        </ul>
        <p class="lg:col-span-full">Data <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Code MIT.</p>
      </div>
    </footer>
  </body>
</html>
